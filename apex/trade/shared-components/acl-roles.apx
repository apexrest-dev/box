role ADMIN (
    name: Адміністратор
    description {
        description: Повний доступ: НСІ, ціни, усі документи, перерахунок собівартості, закриття місяця.
    }
)

role SALES (
    name: Менеджер з продажу
    description {
        description: Замовлення клієнтів, реалізація, рахунки, повернення від клієнтів, оплати від покупців.
    }
)

role PURCHASE (
    name: Закупівельник
    description {
        description: Замовлення постачальникам, надходження, повернення постачальникам, оплати, параметри запасів.
    }
)

role STOREKEEPER (
    name: Комірник
    description {
        description: Переміщення, списання, інвентаризація, оприбуткування надлишків, штрихкоди.
    }
)

role CASHIER (
    name: Касир
    description {
        description: Каси й банківські рахунки організацій (розділ «Фінанси»); у r4 — касові й банківські документи.
    }
)
