lov organizations-active (
    name: ORGANIZATIONS_ACTIVE
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select name d, id r
              from ref_organization
             where state = 'ACTIVE'
             order by case is_default when 'Y' then 0 else 1 end, name
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)
