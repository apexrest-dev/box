lov counterparties-active (
    name: COUNTERPARTIES_ACTIVE
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select name d, id r
              from ref_counterparty
             where state = 'ACTIVE'
             order by name
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)
