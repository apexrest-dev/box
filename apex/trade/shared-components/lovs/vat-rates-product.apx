lov vat-rates-product (
    name: VAT_RATES_PRODUCT
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select name d, code r
              from ref_vat_rate
             where code <> 'NOVAT'
             order by sort_order
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)
