lov cash-registers-active (
    name: CASH_REGISTERS_ACTIVE
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select r.name || ' (' || o.name || ')' d, r.id r
              from ref_cash_register r join ref_organization o on o.id = r.organization_id
             where r.state = 'ACTIVE'
             order by r.code
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)
