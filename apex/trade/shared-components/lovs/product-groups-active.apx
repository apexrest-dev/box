lov product-groups-active (
    name: PRODUCT_GROUPS_ACTIVE
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select full_path d, id r
              from v_product_group_path
             where state = 'ACTIVE'
             order by full_path
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)
