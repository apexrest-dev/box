theme universal-theme (
    name: Universal Theme
    themeNumber: 42
    baseTheme: ut-26.1
    style {
        currentThemeStyle: @1c-taxi
    }
    javaScript {
        fileUrls: [
            #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.stickyWidget#MIN#.js?v=#APEX_VERSION#
            #THEME_FILES#js/theme42#MIN#.js?v=#APEX_VERSION#
        ]
    }
    css {
        fileUrls: #THEME_FILES#css/Core#MIN#.css?v=#APEX_VERSION#
    }
    componentDefaults {
        page: @/standard
        navigationBarList: @/navigation-bar
        navigationMenuListPosition: side
        navigationMenuListTop: @/top-navigation-menu
        navigationMenuListSide: @/side-navigation-menu
        loginPage: @/login
        errorPage: @/login
        printerFriendlyPage: @/standard
        breadcrumb: @/breadcrumb
        button: @/text
        defaultLabel: @/optional-floating
        optionalLabel: @/optional-floating
        requiredLabel: @/required-floating
        list: @/links-list
        region: @/standard
        classicReport: @/standard
    }
    regionDefaults {
        breadcrumbs: @/title-bar
        charts: @/standard
        forms: @/standard
        lists: @/standard
        reports: @/standard
        wizards: @/standard
        interactiveReports: @/interactive-report
    }
    dialogDefaults {
        dialogContentRegion: @/blank-with-attributes
        dialogButtonRegion: @/buttons-container
        dialogPage: @/modal-dialog
    }
    icons {
        library: fontApex
    }
    advanced {
        filePrefix: #APEX_FILES#themes/theme_42/26.1/
        identifier: UNIVERSAL_THEME
    }

    style 1c-taxi (
        name: 1C-Taxi
        css {
            fileUrls: #APEX_FILES#libraries/oracle-fonts/oraclesans-apex#MIN#.css?v=#APEX_VERSION#
        }
        themeRollerAttributes {
            readOnly: false
            inputParameterFileUrls: #THEME_FILES#less/theme/Iris.less
            outputCssFileUrl: #THEME_DB_IMAGES#1c-taxi.css
            jsonConfig:
                ```json
                {
                    "classes": [],
                    "vars": {},
                    "customCSS": ":root {\n  --tx-font: Arial, \"Helvetica Neue\", Helvetica, sans-serif;\n  --tx-text: #333333;\n  --tx-label: #4d4d4d;\n  --tx-muted: #8c8c8c;\n  --tx-panel: #fbf1b8;\n  --tx-panel-hover: #fdf6d6;\n  --tx-panel-border: #e3d48a;\n  --tx-green: #4f9a33;\n  --tx-link: #3c5f8f;\n  --tx-border: #b9b9b9;\n  --tx-grid: #d6d6d6;\n  --tx-head-top: #fafafa;\n  --tx-head-bottom: #e6e6e6;\n  --tx-row-hover: #fff8dc;\n  --tx-row-selected: #fbe9a6;\n  --tx-btn-top: #ffffff;\n  --tx-btn-bottom: #e8e8e8;\n  --tx-btn-border: #b5b5b5;\n  --tx-default-top: #ffe795;\n  --tx-default-bottom: #f6cd45;\n  --tx-default-border: #c9a12f;\n  --tx-toolbar: #f2f2f2;\n  --tx-tab: #e4e4e4;\n  --tx-nav-width: 196px;\n  --ut-body-nav-width: var(--tx-nav-width);\n}\nhtml, body, .t-PageBody, button, input, select, textarea {\n  font-family: var(--tx-font) !important;\n}\nbody.t-PageBody {\n  font-size: 13px;\n  color: var(--tx-text);\n  background: #ffffff;\n}\n.t-Header {\n  background: var(--tx-toolbar) !important;\n  border-bottom: 1px solid #d0d0d0;\n  box-shadow: none !important;\n  min-height: 34px;\n}\n.t-Header-branding, .t-Header-navBar, .t-Header-logo {\n  background: var(--tx-toolbar) !important; min-height: 34px;\n}\n.t-Header { --ut-header-background-color: var(--tx-toolbar); --ut-header-text-color: var(--tx-text); }\n.t-Header .t-Icon, .t-Header .a-Icon, .t-Header .fa, .t-Header-controlsIcon { color: #555 !important; background: transparent !important; }\n.t-Header .t-Button-label, .t-Header .t-NavigationBar-item { color: var(--tx-text) !important; }\n.t-Header-logo-link::after { content: \"Trade — торгівля і склад\"; font-size: 13px; color: var(--tx-text); margin-left: 6px; }\n.t-Header-logo-link .apex-logo-text { display: none; }\n.t-Header-logo, .t-Header-logo-link, .t-Header-logo a { color: var(--tx-text) !important; font-size: 13px; font-weight: normal; }\n.t-Header-logo-link .apex-logo-text::before { content: \"\"; }\n.t-Header .t-Button--header, .t-Header .t-Button--headerTree, .t-Header .t-NavigationBar-item .t-Button {\n  color: #555 !important; background: transparent !important; box-shadow: none !important;\n}\n.t-Header .t-Button--header:hover { background: #e3e3e3 !important; }\n.t-Header-navBar { font-size: 12px; }\n.t-Body-nav, .t-Body-nav .t-TreeNav, .t-TreeNav {\n  background: var(--tx-panel) !important;\n  border-right: 1px solid var(--tx-panel-border);\n}\n.t-PageBody--leftNav.js-navExpanded .t-Body-nav { width: var(--tx-nav-width) !important; }\n.js-navCollapsed .t-TreeNav .a-TreeView-label,\n.js-navCollapsed .t-TreeNav .a-TreeView-content a.a-TreeView-label { color: transparent !important; }\n.js-navCollapsed .t-TreeNav .a-TreeView-row.is-current,\n.js-navCollapsed .t-TreeNav .a-TreeView-row.is-current--top,\n.js-navCollapsed .tx-nav-current > .a-TreeView-row { box-shadow: inset 3px 0 0 #e0b928; }\n.t-TreeNav .a-TreeView-node--topLevel > .a-TreeView-content,\n.t-TreeNav .a-TreeView-node > .a-TreeView-content {\n  color: var(--tx-text) !important;\n  background: transparent !important;\n  border: 0 !important;\n  min-height: 30px;\n  padding-block: 2px;\n}\n.t-TreeNav .a-TreeView-label, .t-TreeNav .a-TreeView-content a { color: var(--tx-text) !important; font-size: 13px; }\n.t-TreeNav .fa, .t-TreeNav .a-Icon { color: #3d3d3d !important; }\n.t-TreeNav .a-TreeView-node > .a-TreeView-content:hover,\n.t-TreeNav .a-TreeView-row:hover + .a-TreeView-content { background: var(--tx-panel-hover) !important; }\n.t-TreeNav .a-TreeView-row { background: transparent !important; }\n.t-TreeNav .a-TreeView-row.is-selected, .t-TreeNav .a-TreeView-row.is-current,\n.t-TreeNav .a-TreeView-row.is-current--top { background: #ffffff !important; box-shadow: inset 3px 0 0 #e0b928; }\n.t-TreeNav .a-TreeView-row.is-hover { background: var(--tx-panel-hover) !important; }\n.tx-nav-current > .a-TreeView-row { background: #ffffff !important; box-shadow: inset 3px 0 0 #e0b928; }\n.t-PageBody--leftNav .t-Body-main { margin-inline-start: 0 !important; }\n.tx-open-tabs {\n  margin: -8px -14px 10px; box-sizing: border-box;\n  display: flex; align-items: flex-end; gap: 2px;\n  background: var(--tx-toolbar); border-bottom: 1px solid #c8c8c8;\n  padding: 4px 6px 0; min-height: 30px; overflow-x: auto; white-space: nowrap;\n  position: sticky; top: 0; z-index: 400;\n}\n.tx-open-tab {\n  display: inline-flex; align-items: center; gap: 6px; max-width: 260px;\n  padding: 4px 8px; font-size: 12px; color: var(--tx-text); text-decoration: none;\n  background: var(--tx-tab); border: 1px solid #c8c8c8; border-bottom: 0; border-radius: 3px 3px 0 0;\n}\n.tx-open-tab span.tx-tab-title { overflow: hidden; text-overflow: ellipsis; }\n.tx-open-tab:hover { background: #efefef; text-decoration: none; }\n.tx-open-tab.is-active { background: #ffffff; position: relative; top: 1px; font-weight: bold; }\n.tx-open-tab .tx-tab-close { color: #888; font-size: 14px; line-height: 1; padding: 0 2px; cursor: pointer; }\n.tx-open-tab .tx-tab-close:hover { color: #c00; }\n.tx-open-tab .fa { font-size: 13px; color: #555; }\n.t-Body-content { background: #ffffff; }\n.t-Body-contentInner { padding: 8px 14px 16px !important; }\n.t-Body-title { display: none !important; }\n.t-Footer { display: none; }\n.tx-form-title { display: flex; align-items: center; gap: 6px; margin: 2px 0 8px; }\n.tx-form-title .tx-nav-btn {\n  width: 24px; height: 22px; display: inline-flex; align-items: center; justify-content: center;\n  border: 1px solid var(--tx-btn-border); border-radius: 2px; color: #555; cursor: pointer;\n  background: linear-gradient(var(--tx-btn-top), var(--tx-btn-bottom)); font-size: 12px;\n}\n.tx-form-title .tx-star { color: #b5b5b5; font-size: 18px; margin: 0 4px; cursor: pointer; }\n.tx-form-title .tx-star.is-on { color: #e8b500; }\n.tx-form-title h1 { font-size: 18px; font-weight: normal; color: var(--tx-text); margin: 0; }\n.t-Region { border: 0 !important; box-shadow: none !important; background: transparent !important; margin-bottom: 6px; }\n.t-Region-header { background: transparent !important; border: 0 !important; min-height: 0; padding: 0; }\n.t-Region-title { font-size: 13px; font-weight: normal; color: var(--tx-green); }\n.t-Region-body { padding: 4px 0 !important; }\n.t-ButtonRegion { background: transparent !important; border: 0 !important; box-shadow: none !important; padding: 0 !important; }\n.t-ButtonRegion-wrap { padding: 0 0 6px !important; }\n.t-ButtonRegion-col { gap: 4px; }\n.tx-tabpart > .t-Region-header {\n  display: flex !important; border-bottom: 1px solid #c8c8c8 !important; margin-bottom: 4px;\n}\n.tx-tabpart > .t-Region-header .t-Region-headerItems--title {\n  display: inline-block; padding: 4px 12px; background: #fff; border: 1px solid #c8c8c8; border-bottom-color: #fff;\n  border-radius: 3px 3px 0 0; position: relative; top: 1px;\n}\n.tx-tabpart > .t-Region-header .t-Region-title { color: var(--tx-text); font-size: 13px; }\n.tx-group-title { color: var(--tx-green); font-size: 13px; margin: 8px 0 2px; }\n.t-Button:where(:not(.t-Button--header):not(.t-Button--headerTree):not(.t-Button--noUI):not(.a-Button)),\n.a-Button.a-IRR-button, .a-IG .a-Button, .a-Toolbar .a-Button, .ui-dialog .ui-button, .a-AlertMessages .a-Button {\n  font-size: 13px !important; font-weight: normal !important; color: var(--tx-text) !important;\n  height: 23px; min-height: 23px; line-height: 21px; padding: 0 10px !important;\n  background: linear-gradient(var(--tx-btn-top), var(--tx-btn-bottom)) !important;\n  border: 1px solid var(--tx-btn-border) !important; border-radius: 3px !important;\n  box-shadow: none !important; text-shadow: none !important;\n}\n.t-Button:where(:not(.t-Button--header)):hover, .a-Button:hover { background: linear-gradient(#ffffff, #f2f2f2) !important; border-color: #9c9c9c !important; }\n.t-Button.t-Button--hot, .a-Button.a-Button--hot, .ui-dialog .ui-button.ui-button--hot {\n  background: linear-gradient(var(--tx-default-top), var(--tx-default-bottom)) !important;\n  border-color: var(--tx-default-border) !important; font-weight: bold !important; color: #333 !important;\n}\n.t-Button.t-Button--hot:hover { background: linear-gradient(#fff0b8, #f8d660) !important; }\n.t-Button .t-Button-label { font-weight: inherit; }\n.t-Form-fieldContainer.rel-col { display: flex !important; align-items: flex-start; gap: 6px; }\n.t-Form-fieldContainer.rel-col > .t-Form-labelContainer {\n  flex: 0 0 auto; width: auto !important; max-width: none !important; min-width: 64px; padding-inline: 0 !important;\n}\n.t-Form-fieldContainer.rel-col > .t-Form-inputContainer {\n  flex: 1 1 auto; width: auto !important; max-width: none !important; padding-inline: 0 !important; min-width: 0;\n}\n.t-Form-fieldContainer.is-required .t-Form-label::before, .t-Form-fieldContainer.is-required .t-Form-label::after { color: inherit; }\n.t-Form-fieldContainer.is-required .t-Form-label::before { content: none !important; display: none !important; }\n.t-Form-fieldContainer.is-required:not(.apex-item-wrapper--has-initial-value):not(.is-readonly) .t-Form-itemWrapper input:not([type=hidden]) {\n  border-bottom: 1px dashed #d23c2a !important;\n}\n.t-Form-itemRequired { display: none !important; }\n.t-Form-itemWrapper input.apex-item-datepicker-readonly, .is-readonly .t-Form-itemWrapper input { background: #f7f7f7 !important; }\n.t-Form-fieldContainer { margin-bottom: 4px; }\n.t-Form-fieldContainer .t-Form-labelContainer { padding-top: 3px !important; padding-bottom: 0 !important; text-align: start !important; }\n.t-Form-label { color: var(--tx-label) !important; font-size: 13px !important; font-weight: normal !important; white-space: nowrap; }\n.t-Form-label::after { content: \":\"; }\n.t-Form-fieldContainer--required .t-Form-label { color: var(--tx-label) !important; }\n.t-Form-fieldContainer .t-Form-required, .t-Form-fieldContainer--required .t-Form-labelContainer::before { display: none !important; }\n.t-Form-inputContainer { padding-top: 0 !important; padding-bottom: 0 !important; }\n.apex-item-text, .apex-item-textarea, .apex-item-select, .apex-item-datepicker input, .apex-item-popup-lov,\n.t-Form-inputContainer input.text_field, .t-Form-inputContainer textarea, .t-Form-inputContainer select,\n.a-GV-columnItem input, .a-IRR-search-field, .a-Toolbar .a-Toolbar-inputText {\n  font-size: 13px !important; color: var(--tx-text) !important;\n  min-height: 23px !important; height: auto; padding: 2px 5px !important;\n  border: 1px solid var(--tx-border) !important; border-radius: 2px !important;\n  background: #ffffff !important; box-shadow: none !important;\n}\n.apex-item-text:focus, .apex-item-textarea:focus, .a-IRR-search-field:focus, .apex-item-popup-lov:focus {\n  border-color: #e0b928 !important; box-shadow: 0 0 0 1px #f3d76d !important; outline: none !important;\n}\n.t-Form-itemWrapper .t-Form-itemAssistance, .t-Form-itemWrapper .a-Button--popupLOV,\n.t-Form-itemWrapper .a-Button--calendar, .t-Form-itemWrapper .t-Form-helpButton {\n  height: 23px !important; min-height: 23px !important; width: 23px; padding: 0 !important;\n  border: 1px solid var(--tx-border) !important; border-left: 0 !important; border-radius: 0 2px 2px 0 !important;\n  background: linear-gradient(var(--tx-btn-top), var(--tx-btn-bottom)) !important; box-shadow: none !important;\n}\n.apex-item-display-only, .display_only {\n  min-height: 23px; padding: 2px 5px; border: 1px solid #e2e2e2; border-radius: 2px; background: #f7f7f7; color: var(--tx-text);\n  display: inline-block; min-width: 100%;\n}\n.t-Form-fieldContainer.is-readonly .apex-item-text, .is-readonly .apex-item-display-only { background: #f7f7f7 !important; }\n.apex-item-textarea { min-height: 46px !important; }\n.t-Form-inlineHelp, .t-Form-helpButton { color: var(--tx-muted); }\n.a-Switch .a-Switch-toggle { border-radius: 2px; }\n.a-IRR, .a-IG { border: 1px solid #c8c8c8 !important; border-radius: 0 !important; box-shadow: none !important; }\n.a-IRR-container { background: transparent; }\n.a-IRR-toolbar, .a-IG-header {\n  background: transparent !important; border: 0 !important; padding: 0 0 6px !important; box-shadow: none !important;\n  display: flex; flex-wrap: wrap; gap: 4px; align-items: center;\n}\n.a-IRR-toolbar .a-IRR-buttons, .a-IRR-toolbar > div:last-child { order: -1; }\n.a-IRR-search-field { width: 220px !important; }\n.a-IRR-table th, .a-IRR-header, .a-GV-header, .a-GV-headerGroup, .a-GV-table th {\n  background: linear-gradient(var(--tx-head-top), var(--tx-head-bottom)) !important;\n  color: var(--tx-label) !important; font-weight: normal !important; font-size: 13px !important;\n  border-color: var(--tx-grid) !important; padding: 3px 6px !important; height: 24px;\n}\n.a-IRR-headerLink, .a-GV-headerLabel { color: var(--tx-label) !important; font-weight: normal !important; }\n.a-IRR-table td, .a-GV-cell, .a-GV-table td {\n  font-size: 13px !important; color: var(--tx-text); padding: 2px 6px !important; height: 22px;\n  border-color: var(--tx-grid) !important; border-style: solid; border-width: 0 1px 1px 0;\n}\n.a-IRR-table tr:hover td, .a-GV-row.is-hover td { background-color: var(--tx-row-hover) !important; }\n.a-IRR-table tr.tx-selected td, .a-GV-row.is-selected td, .a-GV-row.is-selected .a-GV-cell { background-color: var(--tx-row-selected) !important; }\n.a-GV-cell.is-focused { box-shadow: inset 0 0 0 1px #d3a91b !important; }\n.a-IRR-table td.a-IRR-linkCol, .a-IRR-table th#LINK, .a-IRR-table th.a-IRR-header--link { width: 1px; padding: 0 !important; }\n.a-IRR-table td.a-IRR-linkCol a { opacity: 0; display: inline-block; width: 1px; overflow: hidden; }\n.a-IRR-pagination, .a-GV-footer { font-size: 12px; color: var(--tx-muted); background: transparent !important; }\n.a-IRR-paginationWrap { border-top: 1px solid var(--tx-grid); }\n.tx-ico { display: inline-block; width: 16px; text-align: center; font-size: 14px; }\n.tx-ico-draft  { color: #9a9a9a; }\n.tx-ico-posted { color: #3f9a2a; }\n.tx-ico-item   { color: #9a9a9a; font-size: 10px; }\n.tx-ico-marked { color: #d23c2a; }\n.a-IRR-table:has(td.a-IRR-linkCol) tr > :first-child { display: none; }\n.apex-rds-container { background: transparent !important; border-bottom: 1px solid #c8c8c8; box-shadow: none !important; }\n.apex-rds .apex-rds-item a, .apex-rds a { color: var(--tx-text) !important; font-size: 13px; padding: 5px 12px !important; border: 1px solid transparent; border-bottom: 0; }\n.apex-rds .apex-rds-selected a, .apex-rds .is-active a {\n  background: #ffffff; border-color: #c8c8c8 !important; border-radius: 3px 3px 0 0; font-weight: bold; box-shadow: none !important;\n}\n.tx-fp { display: grid; grid-template-columns: repeat(3, minmax(220px, 1fr)); gap: 8px 40px; padding: 8px 6px; }\n.tx-fp-group { color: var(--tx-green); font-size: 15px; font-weight: normal; margin: 14px 0 6px; }\n.tx-fp-col > .tx-fp-group:first-child { margin-top: 2px; }\n.tx-fp-list { list-style: none; margin: 0 0 4px 0; padding: 0 0 0 14px; }\n.tx-fp-list li { padding: 3px 0; }\n.tx-fp-link { color: var(--tx-text) !important; text-decoration: none; }\n.tx-fp-link:hover { text-decoration: underline; color: #000 !important; }\n.tx-fp-link.tx-important { font-weight: bold; }\n.tx-fp-create { color: var(--tx-muted); font-size: 13px; }\n.tx-tasks { border-left: 1px solid #e3e3e3; padding-left: 20px; }\n.tx-task-value { color: var(--tx-muted); margin-left: 6px; }\n.tx-home { display: grid; grid-template-columns: 3fr 1fr; gap: 20px; }\n.ui-dialog .ui-dialog-titlebar { background: var(--tx-toolbar) !important; border-bottom: 1px solid #d0d0d0; }\n.ui-dialog .ui-dialog-title { font-size: 15px; font-weight: normal; color: var(--tx-text); }\n.t-Alert--page, .t-Body-alert .t-Alert { border-radius: 2px !important; }\n.t-Alert--success { background: #f4fbef !important; border: 1px solid #9ccc82 !important; }\n.t-Alert--warning, .t-Alert--danger { background: #fff5f2 !important; border: 1px solid #e3a08d !important; }\n.t-Alert--success, .t-Alert--success .t-Alert-title, .t-Alert--success .t-Alert