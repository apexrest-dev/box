authorization role-tax (
    name: Роль: податковий облік
    type: isInRoleOrGroup
    settings {
        type: applicationRole
        names: [
            Адміністратор
            Менеджер з продажу
            Закупівельник
            Касир
        ]
    }
    error {
        errorMessage: Недостатньо прав: податкові накладні доступні ролям «Менеджер з продажу», «Закупівельник», «Касир».
    }
    advanced {
        evaluationType: perSession
    }
)
