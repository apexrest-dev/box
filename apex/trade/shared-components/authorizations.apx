authorization administration-rights (
    name: Administration Rights
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return true;
    }
    error {
        errorMessage: Insufficient privileges, user is not an Administrator
    }
)


authorization role-admin (
    name: Роль: адміністратор
    type: isInRoleOrGroup
    settings {
        type: applicationRole
        names: [
            Адміністратор
        ]
    }
    error {
        errorMessage: Недостатньо прав: потрібна роль «Адміністратор».
    }
    advanced {
        evaluationType: perSession
    }
)

authorization role-sales (
    name: Роль: продажі
    type: isInRoleOrGroup
    settings {
        type: applicationRole
        names: [
            Адміністратор
            Менеджер з продажу
        ]
    }
    error {
        errorMessage: Недостатньо прав: потрібна роль «Менеджер з продажу».
    }
    advanced {
        evaluationType: perSession
    }
)

authorization role-purchase (
