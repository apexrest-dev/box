    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_customer_return_goods (document_id, line_number, quantity)
                    values (:P281_ID, null,
                            to_number(:QUANTITY, 'FM999G999G999G990D000'))
                    returning id into :ID;
                  when 'U' then
                    update doc_customer_return_goods
                       set quantity = to_number(:QUANTITY, 'FM999G999G999G990D000')
                     where id = :ID and document_id = :P281_ID;
                  when 'D' then
                    delete from doc_customer_return_goods where id = :ID and document_id = :P281_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000244
        }
    )

