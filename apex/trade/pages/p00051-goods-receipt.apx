    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @header
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000108
        }
    )

    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000109
        }
    )

    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_goods_receipt_goods (document_id, line_number, product_id, characteristic_id, series_id, quantity, price, vat_rate_code)
                    values (:P51_ID, null,
                            :PRODUCT_ID,
                            :CHARACTERISTIC_ID,
                            :SERIES_ID,
                            to_number(:QUANTITY, 'FM999G999G999G990D000'),
                            to_number(:PRICE, 'FM999G999G999G990D00'),
                            :VAT_RATE_CODE)
                    returning id into :ID;
                  when 'U' then
                    update doc_goods_receipt_goods
                       set product_id = :PRODUCT_ID,
                           characteristic_id = :CHARACTERISTIC_ID,
                           series_id = :SERIES_ID,
                           quantity = to_number(:QUANTITY, 'FM999G999G999G990D000'),
                           price = to_number(:PRICE, 'FM999G999G999G990D00'),
                           vat_rate_code = :VAT_RATE_CODE
                     where id = :ID and document_id = :P51_ID;
                  when 'D' then
                    delete from doc_goods_receipt_goods where id = :ID and document_id = :P51_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000110
        }
    )

    process post (
        name: Провести
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_warn.clear;
                trade_doc.post_goods_receipt(:P51_ID);
                :TRADE_WARN := trade_warn.take;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ проведено. &TRADE_WARN.
        }
        advanced {
            executionMappingIdentifier: 910000000111
        }
    )

    process unpost (
        name: Скасувати проведення
        type: executeCode
