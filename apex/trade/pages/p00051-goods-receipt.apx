        }
    )

    process copy (
        name: Скопіювати
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_src varchar2(32) := :P51_ID;
                begin
                  :P51_ID := trade_doc.copy_goods_receipt(l_src);
                  trade_series.copy_dims('DocGoodsReceipt', l_src, :P51_ID);
                  trade_vat.copy_lines('DocGoodsReceipt', l_src, :P51_ID);
                end;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @copy
        }
        successMessage {
            successMessage: Створено копію документа (чернетка).
        }
        advanced {
            executionMappingIdentifier: 910000000113
        }
    )

