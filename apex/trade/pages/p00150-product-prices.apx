page 150 (
    name: Ціни номенклатури
    alias: PRODUCT-PRICES
    title: Ціни номенклатури
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Ціни номенклатури</h1></div>
        }
        layout {
            sequence: 0
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region mode (
        name: Режим
        type: regionDisplaySelector
        layout {
            sequence: 5
            slot: body
        }
        settings {
            mode: viewSingleRegion
            includeShowAll: false
            rememberSelection: bySession
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region current (
        name: Діючі ціни
        title: Діючі ціни
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select price_type_name, product_code, product_name, unit_name, price, period
                  from v_product_price_current
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            regionDisplaySelector: true
            savedReportMappingIdentifier: 910000000403
        }


        column PRICE_TYPE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Вид цін
            }
            layout {
                sequence: 10
            }
        )

        column PRODUCT_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Код товару
            }
            layout {
                sequence: 20
            }
        )

        column PRODUCT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Товар
            }
            layout {
                sequence: 30
            }
        )

        column UNIT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Од.
            }
            layout {
                sequence: 40
            }
        )

        column PRICE (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Ціна
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column PERIOD (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Діє з
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
        )
    )

    region history (
        name: Історія
        title: Історія
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.period, m.recorder_name, apex_page.get_url(p_page => m.page_id, p_items => 'P' || m.page_id || '_ID', p_values => m.recorder_id) recorder_url,
                       m.price_type_name, m.product_name, m.unit_name, m.price
                  from v_product_price_history m
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            regionDisplaySelector: true
            savedReportMappingIdentifier: 910000000404
        }


        column PERIOD (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Діє з
            }
            layout {
                sequence: 10
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
        )

        column RECORDER_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Реєстратор
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <a href="#RECORDER_URL#">#RECORDER_NAME#</a>
            }
        )

        column RECORDER_URL (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: URL
            }
            layout {
                sequence: 30
            }
        )

        column PRICE_TYPE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Вид цін
            }
            layout {
                sequence: 40
            }
        )

        column PRODUCT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Товар
            }
            layout {
                sequence: 50
            }
        )

        column UNIT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Од.
            }
            layout {
                sequence: 60
            }
        )

        column PRICE (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Ціна
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )
    )
)
