page 120 (
    name: Оплати від покупців
    alias: CUSTOMER-PAYMENTS
    title: Оплати від покупців
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-sales-or-cashier
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Оплати від покупців</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region list (
        name: Оплати від покупців
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.id, case when d.status in ('POSTED', 'ISSUED') then 'fa-file-text-o tx-ico-posted' when d.status = 'CANCELLED' then 'fa-times tx-ico-marked' else 'fa-file-o tx-ico-draft' end icon_class, ' ' state_icon, d.organization_name, d.doc_number, d.occurred_at, d.customer_name, d.payment_form_name, d.source_name, d.amount, d.currency_code, d.allocated_amount, d.contract_name, d.customer_order_number, d.invoice_number, d.statement_number, case d.status when 'POSTED' then 'Проведено' else 'Чернетка' end status_name, d.doc_comment
                  from v_customer_payment_list d
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 121
                clearCache: 121
                items: {
                    P121_ID: #ID#
                }
            }
            linkIcon: <span class="fa fa-file-text-o" aria-hidden="true" title="Відкрити"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000158
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

        column STATE_ICON (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ​
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="tx-ico fa #ICON_CLASS#" aria-hidden="true"></span>
            }
        )

        column ICON_CLASS (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: icon
            }
            layout {
                sequence: 30
            }
        )

        column DOC_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Номер
            }
            layout {
                sequence: 40
            }
        )

        column OCCURRED_AT (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
        )

        column ORGANIZATION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Організація
            }
            layout {
                sequence: 60
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Покупець
            }
            layout {
                sequence: 70
            }
        )

        column PAYMENT_FORM_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Форма оплати
            }
            layout {
                sequence: 80
            }
        )

        column SOURCE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Рахунок / каса
            }
            layout {
                sequence: 90
            }
        )

        column AMOUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Сума оплати
            }
            layout {
                sequence: 100
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column CURRENCY_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Валюта
            }
            layout {
                sequence: 110
            }
        )

        column ALLOCATED_AMOUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Розподілено
            }
            layout {
                sequence: 120
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column CONTRACT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Договір
            }
            layout {
                sequence: 130
            }
        )

        column CUSTOMER_ORDER_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Замовлення
            }
            layout {
                sequence: 140
            }
        )

        column INVOICE_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Рахунок
            }
            layout {
                sequence: 150
            }
        )

        column STATEMENT_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Виписка
            }
            layout {
                sequence: 160
            }
        )

        column DOC_COMMENT (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Коментар
            }
            layout {
                sequence: 170
            }
        )
    )

    button create (
        buttonName: CREATE
        label: Створити
        layout {
            sequence: 10
            region: @list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 121
                clearCache: 121
            }
        }
    )
)
