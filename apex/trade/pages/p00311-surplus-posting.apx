        }
    )

    button pick (
        buttonName: PICK
        label: Підбір
        layout {
            sequence: 30
            region: @scan
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 950
                clearCache: 950
                items: {
                    P950_KIND: SURPLUS
                    P950_ID: &P311_ID.
                    P950_WH: &P311_WAREHOUSE_ID.
                }
            }
        }
    )

    dynamicAction after-pick (
        name: Після підбору
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pick
        }
        execution {
            sequence: 10
        }

        action reload (
            name: Перезавантажити
            action: submitPage
            settings {
                requestButtonName: PICKED
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    region lines (
        name: Товари
        title: Товари
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, document_id, line_number, product_id, characteristic_id, series_id, quantity, price, amount
                  from doc_surplus_posting_goods
                 where document_id = :P311_ID
                 order by line_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: tx-tabpart
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P311_STATUS is not null and :P311_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                actionsMenu
            ]
            addButtonLabel: Додати рядок
        }
        advanced {
            savedReportMappingIdentifier: 910000000269
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn LINE_NUMBER (
                column: @LINE_NUMBER
                layout {
                    sequence: 10
                    show: true
                    width: 50
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 380
                }
            )

            displayColumn CHARACTERISTIC_ID (
                column: @CHARACTERISTIC_ID
                layout {
                    sequence: 30
                    show: true
                    width: 200
                }
            )

            displayColumn SERIES_ID (
                column: @SERIES_ID
                layout {
                    sequence: 40
                    show: true
                    width: 220
                }
            )

            displayColumn QUANTITY (
                column: @QUANTITY
                layout {
                    sequence: 50
                    show: true
                    width: 130
                }
            )

            displayColumn PRICE (
                column: @PRICE
                layout {
                    sequence: 60
                    show: true
                    width: 130
                }
            )

            displayColumn AMOUNT (
                column: @AMOUNT
                layout {
                    sequence: 70
                    show: true
                    width: 140
                }
            )
        )

        column ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: ID
                dataType: varchar2
                primaryKey: true
            }
            layout {
                sequence: 10
            }
        )

        column DOCUMENT_ID (
            type: hidden
