    pageItem P311_SCAN (
        type: textField
        label {
            label: Штрихкод / артикул
            alignment: right
        }
        layout {
            sequence: 10
            region: @scan
            slot: regionBody
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            valuePlaceholder: Відскануйте або введіть і натисніть «Додати»
        }
        advanced {
