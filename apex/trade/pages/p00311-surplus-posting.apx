        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    button scan (
        buttonName: SCAN
        label: Додати
        layout {
            sequence: 20
            region: @scan
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
