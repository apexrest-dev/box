        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P311_NEW_ID (
        type: hidden
        layout {
            sequence: 100
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    region scan (
        name: Сканер
        type: staticContent
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P311_ID is not null and :P311_STATUS = 'DRAFT'
        }
