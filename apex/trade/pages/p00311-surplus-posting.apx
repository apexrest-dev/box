                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
            help {
                helpText: Для товарів з обліком серій. У видаткових документах порожня серія підбирається за FEFO під час проведення.
            }
        )

        column QUANTITY (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: QUANTITY
                dataType: number
            }
            heading {
                heading: Кількість
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column PRICE (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: PRICE
                dataType: number
            }
            heading {
                heading: Ціна
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Сума
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )
