page 580 (
    name: Товари до надходження й відвантаження
    alias: GOODS-ORDER-SCHEME
    title: Товари до надходження й відвантаження
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Товари до надходження й відвантаження</h1></div>
        }
        layout {
            sequence: 0
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region mode (
        name: Режим
        type: regionDisplaySelector
        layout {
            sequence: 5
            slot: body
        }
        settings {
            mode: viewSingleRegion
            includeShowAll: false
            rememberSelection: bySession
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region receipts (
        name: Очікується надходження
        title: Очікується надходження
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.warehouse_name, b.basis_name, apex_page.get_url(p_page => b.basis_page_id, p_items => 'P' || b.basis_page_id || '_ID', p_values => b.basis_id) basis_url, b.basis_date, b.planned_qty, b.done_qty,
                       b.remaining_qty, b.state_name
                  from v_goods_order_basis b
                 where b.direction = 'RECEIPT'
                 order by b.basis_date desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            regionDisplaySelector: true
            savedReportMappingIdentifier: 910000000446
        }


        column WAREHOUSE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Склад
            }
            layout {
                sequence: 10
            }
        )

        column BASIS_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Розпорядження
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <a href="#BASIS_URL#">#BASIS_NAME#</a>
            }
        )

        column BASIS_URL (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: URL
            }
            layout {
                sequence: 30
            }
        )

        column BASIS_DATE (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата
            }
            layout {
                sequence: 40
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI
            }
        )

        column PLANNED_QTY (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: За документом
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column DONE_QTY (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Прийнято
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column REMAINING_QTY (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Залишок
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column STATE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Стан
            }
            layout {
                sequence: 80
            }
        )
    )

    region shipments (
        name: Розпорядження на відвантаження
        title: Розпорядження на відвантаження
