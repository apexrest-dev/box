    region by-product (
        name: За товарами
        title: За товарами
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.direction_name, v.warehouse_name, v.product_code, v.product_name, v.characteristic_name, v.series_name,
                       v.unit_name, sum(v.planned_qty) planned_qty, sum(v.done_qty) done_qty, sum(v.remaining_qty) remaining_qty
                  from v_goods_order_balance v
                 where v.remaining_qty <> 0
                 group by v.direction_name, v.warehouse_name, v.product_code, v.product_name, v.characteristic_name, v.series_name, v.unit_name
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
