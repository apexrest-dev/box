page 220 (
    name: Резерви та вільні залишки
    alias: FREE-STOCK
    title: Резерви та вільні залишки
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Резерви та вільні залишки</h1></div>
        }
        layout {
            sequence: 0
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region mode (
        name: Режим
        type: regionDisplaySelector
        layout {
            sequence: 5
            slot: body
        }
        settings {
            mode: viewSingleRegion
            includeShowAll: false
            rememberSelection: bySession
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region free (
        name: Вільні залишки
        title: Вільні залишки
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select warehouse_name, product_code, product_name, unit_name, stock_qty, reserved_qty, free_qty
                  from v_free_stock
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            regionDisplaySelector: true
            savedReportMappingIdentifier: 910000000414
        }


        column WAREHOUSE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Склад
            }
            layout {
                sequence: 10
            }
        )

        column PRODUCT_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Код
            }
            layout {
                sequence: 20
            }
        )

        column PRODUCT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Товар
            }
            layout {
                sequence: 30
            }
        )

        column UNIT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Од.
            }
            layout {
                sequence: 40
            }
        )

        column STOCK_QTY (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Залишок
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column RESERVED_QTY (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Резерв
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column FREE_QTY (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Вільно
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )
    )

    region reserves (
        name: Резерви за замовленнями
        title: Резерви за замовленнями
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select order_number, customer_name, warehouse_name, product_name, unit_name, reserved_qty
                  from v_stock_reserve
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            regionDisplaySelector: true
            savedReportMappingIdentifier: 910000000415
        }


        column ORDER_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Замовлення
            }
            layout {
                sequence: 10
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Покупець
            }
            layout {
                sequence: 20
            }
        )

        column WAREHOUSE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Склад
            }
            layout {
                sequence: 30
            }
        )

        column PRODUCT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Товар
            }
            layout {
                sequence: 40
            }
        )

        column UNIT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Од.
            }
            layout {
                sequence: 50
            }
        )

        column RESERVED_QTY (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Резерв
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )
    )
)
