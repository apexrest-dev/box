page 460 (
    name: ABC-аналіз продажів
    alias: ABC-ANALYSIS
    title: ABC-аналіз продажів
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>ABC-аналіз продажів</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region bar (
        name: Параметри
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: tx-print-bar
        }
    )

    pageItem P460_DIM (
        type: selectList
        label {
            label: Розріз
            alignment: right
        }
        layout {
            sequence: 10
            region: @bar
            slot: regionBody
            columnSpan: 2
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: PRODUCT
        }
        lov {
            type: sharedComponent
            lov: @abc-dimensions
            displayExtraValues: false
            displayNullValue: false
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P460_MEASURE (
        type: selectList
        label {
            label: Показник
            alignment: right
        }
        layout {
            sequence: 12
            region: @bar
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: REVENUE
        }
        lov {
            type: sharedComponent
            lov: @abc-measures
            displayExtraValues: false
            displayNullValue: false
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P460_FROM (
        type: datePicker
        label {
            label: З
            alignment: right
        }
        layout {
            sequence: 14
            region: @bar
            slot: regionBody
            columnSpan: 2
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(trunc(sysdate, 'MM'), 'DD.MM.YYYY')
        }
        settings {
            displayAs: popup
            showTime: false
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P460_TO (
        type: datePicker
        label {
            label: По
            alignment: right
        }
        layout {
            sequence: 15
            region: @bar
            slot: regionBody
            columnSpan: 2
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY')
        }
        settings {
            displayAs: popup
            showTime: false
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P460_ORG (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 20
            region: @bar
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @organizations-all
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: Усі організації
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P460_GROUP (
        type: selectList
        label {
            label: Група номенклатури
            alignment: right
        }
        layout {
            sequence: 22
            region: @bar
            slot: regionBody
            columnSpan: 4
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @product-groups-active
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: Усі групи
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P460_A (
        type: numberField
        label {
            label: Межа A, %
            alignment: right
        }
        layout {
            sequence: 24
            region: @bar
            slot: regionBody
            columnSpan: 1
            startNewRow: false
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 80
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P460_B (
        type: numberField
        label {
            label: Межа B, %
            alignment: right
        }
        layout {
            sequence: 25
            region: @bar
            slot: regionBody
            columnSpan: 1
            startNewRow: false
        }
        appearance {
            template: @/required-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: 15
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
        }
        help {
            helpText: Межі класів — частка показника наростаючим підсумком: A — до межі A, B — наступні до A + B, C — решта. Позиція, що перетинає межу, належить вищому класу; позиції з показником ≤ 0 — клас C.
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    button show (
        buttonName: SHOW
        label: Сформувати
        layout {
            sequence: 40
            region: @bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    button print (
        buttonName: PRINT
        label: Друк
        layout {
            sequence: 50
            region: @bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    region abc (
        name: ABC-аналіз
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return trade_abc.abc_html(coalesce(:P460_DIM, 'PRODUCT'), coalesce(:P460_MEASURE, 'REVENUE'),
                         coalesce(to_date(:P460_FROM, 'DD.MM.YYYY'), trunc(sysdate, 'MM')),
                         coalesce(to_date(:P460_TO, 'DD.MM.YYYY'), trunc(sysdate)),
                         :P460_ORG, :P460_GROUP, trade_abc.to_num(:P460_A, 80), trade_abc.to_num(:P460_B, 15));
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    dynamicAction print (
        name: Друк
        when {
            event: click
            selectionType: button
            button: @print
        }
        execution {
            sequence: 10
        }

        action print (
            name: Друк
            action: executeJsCode
            settings {
                jsCode: window.print();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
