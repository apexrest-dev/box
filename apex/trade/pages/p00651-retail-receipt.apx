page 651 (
    name: Чек ККМ
    alias: RETAIL-RECEIPT
    title: Чек ККМ
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-sales-or-cashier
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>&P651_FORM_TITLE.</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Команди
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region header (
        name: Чек ККМ
        title: Чек ККМ
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: DOC_RETAIL_RECEIPT
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P651_STATUS is not null and :P651_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    pageItem P651_ID (
        type: hidden
        layout {
            sequence: 10
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P651_DOC_NUMBER (
        type: textField
        label {
            label: Номер
            alignment: right
        }
        layout {
            sequence: 20
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @header
            column: DOC_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Порожній номер буде призначено автоматично.
        }
    )

    pageItem P651_OCCURRED_AT (
        type: datePicker
        label {
            label: Дата
            alignment: right
        }
        layout {
            sequence: 30
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: OCCURRED_AT
            dataType: date
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY HH24:MI:SS')
        }
        settings {
            displayAs: popup
            showTime: true
        }
    )

    pageItem P651_CASH_REGISTER_ID (
        type: popupLov
        label {
            label: Каса ККМ
            alignment: right
        }
        layout {
            sequence: 40
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: CASH_REGISTER_ID
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trade_retail.default_register
        }
        lov {
            type: sharedComponent
            lov: @cash-registers-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
        help {
            helpText: Організація, склад, каса, вид цін і роздрібний покупець беруться з каси ККМ.
        }
    )

    pageItem P651_ORGANIZATION_ID (
        type: displayOnly
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 50
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: ORGANIZATION_ID
            dataType: varchar2
            queryOnly: true
        }
        lov {
            type: sharedComponent
            lov: @organizations-all
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P651_WAREHOUSE_ID (
        type: displayOnly
        label {
            label: Склад
            alignment: right
        }
        layout {
            sequence: 60
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: WAREHOUSE_ID
            dataType: varchar2
            queryOnly: true
        }
        lov {
            type: sharedComponent
            lov: @warehouses-all
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P651_CASH_DESK_ID (
        type: displayOnly
        label {
            label: Каса
            alignment: right
        }
        layout {
            sequence: 70
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CASH_DESK_ID
            dataType: varchar2
            queryOnly: true
        }
        lov {
            type: sharedComponent
            lov: @cash-desks-active
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P651_PAID_CASH (
        type: numberField
        label {
            label: Отримано готівкою
            alignment: right
        }
        layout {
            sequence: 80
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: PAID_CASH
            dataType: number
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
        }
        help {
            helpText: Порожньо й без картки — оплата готівкою без решти.
        }
    )

    pageItem P651_PAID_CARD (
        type: numberField
        label {
            label: Оплата карткою
            alignment: right
        }
        layout {
            sequence: 90
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: PAID_CARD
            dataType: number
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
        }
        help {
            helpText: Не більше суми чека.
        }
    )

    pageItem P651_CHANGE_AMOUNT (
        type: displayOnly
        label {
            label: Решта
            alignment: right
        }
        layout {
            sequence: 100
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: CHANGE_AMOUNT
            dataType: number
            queryOnly: true
        }
    )

    pageItem P651_CASHIER_NAME (
        type: displayOnly
        label {
            label: Касир
            alignment: right
        }
        layout {
            sequence: 110
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CASHIER_NAME
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P651_FISCAL_STATUS (
        type: displayOnly
        label {
            label: ПРРО
            alignment: right
        }
        layout {
            sequence: 120
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: FISCAL_STATUS
            dataType: varchar2
            queryOnly: true
        }
        lov {
            type: sharedComponent
            lov: @fiscal-statuses
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P651_FISCAL_NUMBER (
        type: displayOnly
        label {
            label: Фіскальний номер чека
            alignment: right
        }
        layout {
            sequence: 130
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: FISCAL_NUMBER
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P651_FISCAL_AT (
        type: displayOnly
        label {
            label: Фіскалізовано
            alignment: right
        }
        layout {
            sequence: 140
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
        source {
            formRegion: @header
            column: FISCAL_AT
            dataType: date
            queryOnly: true
        }
    )

    pageItem P651_FISCAL_URL (
        type: displayOnly
        label {
            label: Перевірка чека
            alignment: right
        }
        layout {
            sequence: 150
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: FISCAL_URL
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P651_STATUS (
        type: hidden
        layout {
            sequence: 160
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: STATUS
            dataType: varchar2
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P651_FORM_TITLE (
        type: hidden
        layout {
            sequence: 170
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P651_NEW_ID (
        type: hidden
        layout {
            sequence: 180
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    region scan (
        name: Сканер
        type: staticContent
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P651_ID is not null and :P651_STATUS = 'DRAFT'
        }
    )

    pageItem P651_SCAN (
        type: textField
        label {
            label: Штрихкод / артикул
            alignment: right
        }
        layout {
            sequence: 10
            region: @scan
            slot: regionBody
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            valuePlaceholder: Відскануйте або введіть і натисніть «Додати»
        }
        advanced {
            customAttributes: autocomplete="off"
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    button scan (
        buttonName: SCAN
        label: Додати
        layout {
            sequence: 20
            region: @scan
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
    )

    region lines (
        name: Товари
        title: Товари
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, document_id, line_number, product_id, characteristic_id, series_id, quantity, price, amount, trade_vat.rate_name(vat_rate_code) vat_name, vat_amount, cost_amount
                  from doc_retail_receipt_goods
                 where document_id = :P651_ID
                 order by line_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: tx-tabpart
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P651_STATUS is not null and :P651_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                actionsMenu
            ]
            addButtonLabel: Додати рядок
        }
        advanced {
            savedReportMappingIdentifier: 910000000386
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn LINE_NUMBER (
                column: @LINE_NUMBER
                layout {
                    sequence: 10
                    show: true
                    width: 50
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 380
                }
            )

            displayColumn CHARACTERISTIC_ID (
                column: @CHARACTERISTIC_ID
                layout {
                    sequence: 30
                    show: true
                    width: 200
                }
            )

            displayColumn SERIES_ID (
                column: @SERIES_ID
                layout {
                    sequence: 40
                    show: true
                    width: 220
                }
            )

            displayColumn QUANTITY (
                column: @QUANTITY
                layout {
                    sequence: 50
                    show: true
                    width: 130
                }
            )

            displayColumn PRICE (
                column: @PRICE
                layout {
                    sequence: 60
                    show: true
                    width: 130
                }
            )

            displayColumn AMOUNT (
                column: @AMOUNT
                layout {
                    sequence: 70
                    show: true
                    width: 140
                }
            )

            displayColumn VAT_NAME (
                column: @VAT_NAME
                layout {
                    sequence: 80
                    show: true
                    width: 110
                }
            )

            displayColumn VAT_AMOUNT (
                column: @VAT_AMOUNT
                layout {
                    sequence: 90
                    show: true
                    width: 110
                }
            )

            displayColumn COST_AMOUNT (
                column: @COST_AMOUNT
                layout {
                    sequence: 100
                    show: true
                    width: 120
                }
            )
        )

        column ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: ID
                dataType: varchar2
                primaryKey: true
            }
            layout {
                sequence: 10
            }
        )

        column DOCUMENT_ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: DOCUMENT_ID
                dataType: varchar2
            }
            layout {
                sequence: 20
            }
        )

        column LINE_NUMBER (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: LINE_NUMBER
                dataType: number
            }
            heading {
                heading: N
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column PRODUCT_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: PRODUCT_ID
                dataType: varchar2
            }
            heading {
                heading: Товар
                alignment: start
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @products-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
        )

        column CHARACTERISTIC_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: CHARACTERISTIC_ID
                dataType: varchar2
            }
            heading {
                heading: Характеристика
                alignment: start
            }
            layout {
                sequence: 50
            }
            lov {
                type: sharedComponent
                lov: @product-characteristics-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
            help {
                helpText: Для товарів з ознакою «Використовувати характеристики» (розмір, колір …) — обов'язкова при проведенні.
            }
        )

        column SERIES_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: SERIES_ID
                dataType: varchar2
            }
            heading {
                heading: Серія
                alignment: start
            }
            layout {
                sequence: 60
            }
            lov {
                type: sharedComponent
                lov: @product-series-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
            help {
                helpText: Для товарів з обліком серій. У видаткових документах порожня серія підбирається за FEFO під час проведення.
            }
        )

        column QUANTITY (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: QUANTITY
                dataType: number
            }
            heading {
                heading: Кількість
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column PRICE (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: PRICE
                dataType: number
            }
            heading {
                heading: Ціна
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            help {
                helpText: Порожньо — роздрібна ціна виду цін каси ККМ на дату чека (включає ПДВ).
            }
        )

        column AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Сума
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column VAT_NAME (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: VAT_NAME
                dataType: varchar2
                queryOnly: true
            }
            heading {
                heading: Ставка ПДВ
                alignment: start
            }
            layout {
                sequence: 100
            }
        )

        column VAT_AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: VAT_AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: у т. ч. ПДВ
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column COST_AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: COST_AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Собівартість
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )
    )

    region footer (
        name: Підвал
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P651_VAT_AMOUNT (
        type: displayOnly
        label {
            label: Сума ПДВ
            alignment: right
        }
        layout {
            sequence: 190
            region: @footer
            slot: regionBody
            columnSpan: 3
            column: 7
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: VAT_AMOUNT
            dataType: number
        }
    )

    pageItem P651_TOTAL_AMOUNT (
        type: displayOnly
        label {
            label: Всього
            alignment: right
        }
        layout {
            sequence: 200
            region: @footer
            slot: regionBody
            columnSpan: 3
            startNewRow: false
            column: 10
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: TOTAL_AMOUNT
            dataType: number
        }
    )

    pageItem P651_DOC_COMMENT (
        type: textarea
        label {
            label: Коментар
            alignment: right
        }
        layout {
            sequence: 210
            region: @footer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @header
            column: DOC_COMMENT
            dataType: varchar2
        }
        settings {
            resizable: true
            autoHeight: false
            charCounter: true
            trimSpaces: leadingAndTrailing
        }
    )

    process form-title (
        name: Заголовок форми
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P651_FORM_TITLE := trade_ui.doc_title('Чек ККМ', :P651_DOC_NUMBER, :P651_OCCURRED_AT, :P651_STATUS);
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000387
        }
    )

    button create-post-close (
        buttonName: CREATE_POST_CLOSE
        label: Провести і закрити
        layout {
            sequence: 10
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P651_ID
        }
    )

    button post-close (
        buttonName: POST_CLOSE
        label: Провести і закрити
        layout {
            sequence: 11
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P651_ID is not null and :P651_STATUS = 'DRAFT'
        }
    )

    button create (
        buttonName: CREATE
        label: Записати
        layout {
            sequence: 20
