    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @header
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000388
        }
    )

    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000389
        }
    )

    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_retail_receipt_goods (document_id, line_number, product_id, characteristic_id, series_id, quantity, price)
                    values (:P651_ID, null,
                            :PRODUCT_ID,
                            :CHARACTERISTIC_ID,
                            :SERIES_ID,
                            to_number(:QUANTITY, 'FM999G999G999G990D000'),
                            to_number(:PRICE, 'FM999G999G999G990D00'))
                    returning id into :ID;
                  when 'U' then
                    update doc_retail_receipt_goods
                       set product_id = :PRODUCT_ID,
                           characteristic_id = :CHARACTERISTIC_ID,
                           series_id = :SERIES_ID,
                           quantity = to_number(:QUANTITY, 'FM999G999G999G990D000'),
                           price = to_number(:PRICE, 'FM999G999G999G990D00')
                     where id = :ID and document_id = :P651_ID;
                  when 'D' then
                    delete from doc_retail_receipt_goods where id = :ID and document_id = :P651_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000390
        }
    )

    process post (
        name: Провести
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_warn.clear;
                trade_retail.post(:P651_ID);
                :TRADE_WARN := trade_warn.take;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Чек проведено. &TRADE_WARN.
        }
        advanced {
            executionMappingIdentifier: 910000000391
        }
    )

    process unpost (
        name: Скасувати проведення
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_retail.unpost(:P651_ID);
                ```
        }
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @unpost
        }
        successMessage {
            successMessage: Проведення документа скасовано.
        }
        advanced {
            executionMappingIdentifier: 910000000392
        }
    )

    process copy (
        name: Скопіювати
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_src varchar2(32) := :P651_ID;
                begin
                  :P651_ID := trade_retail.copy(l_src);
                  trade_series.copy_dims('DocRetailReceipt', l_src, :P651_ID);
                end;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @copy
        }
        successMessage {
            successMessage: Створено копію документа (чернетка).
        }
        advanced {
            executionMappingIdentifier: 910000000393
        }
    )

    process cmd-fill-series (
        name: Підібрати серії (FEFO)
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_series.fill_fefo('DocRetailReceipt', :P651_ID);
                ```
        }
        execution {
            sequence: 60
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('FILL_SERIES')
        }
        successMessage {
            successMessage: Серії підібрано за FEFO (першим спливає — першим відвантажено).
        }
        advanced {
            executionMappingIdentifier: 910000000394
        }
    )

