page 550 (
    name: Комірки складів
    alias: STORAGE-BINS
    title: Комірки складів
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Комірки складів</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region list (
        name: Комірки складів
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case state when 'ACTIVE' then 'fa-square tx-ico-item' else 'fa-times tx-ico-marked' end icon_class, ' ' state_icon, id, code, warehouse_name, name, rack, tier, place, quantity, products_count, description, case state when 'ACTIVE' then 'Активний' else 'Помічений на видалення' end state_name from v_storage_bin_list
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 551
                clearCache: 551
                items: {
                    P551_ID: #ID#
                }
            }
            linkIcon: <span class="fa fa-edit" aria-hidden="true" title="Відкрити"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000087
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

        column STATE_ICON (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ​
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="tx-ico fa #ICON_CLASS#" aria-hidden="true"></span>
            }
        )

        column ICON_CLASS (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: icon
            }
            layout {
                sequence: 30
            }
        )

        column CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Код
            }
            layout {
                sequence: 40
            }
        )

        column WAREHOUSE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Склад
            }
            layout {
                sequence: 50
            }
        )

        column NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Адреса
            }
            layout {
                sequence: 60
            }
        )

        column RACK (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Стелаж
            }
            layout {
                sequence: 70
            }
        )

        column TIER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Ярус
            }
            layout {
                sequence: 80
            }
        )

        column PLACE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Місце
            }
            layout {
                sequence: 90
            }
        )

        column QUANTITY (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Кількість товарів
            }
            layout {
                sequence: 100
            }
        )

        column PRODUCTS_COUNT (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Позицій
            }
            layout {
                sequence: 110
            }
        )

        column DESCRIPTION (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Опис
            }
            layout {
                sequence: 120
            }
        )
    )

    button create (
        buttonName: CREATE
        label: Створити
        layout {
            sequence: 10
            region: @list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 551
                clearCache: 551
            }
        }
        security {
            authorizationScheme: @role-warehouse
        }
    )

    dynamicAction refresh-on-close (
        name: Оновити після закриття діалогу
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @list
        }
        execution {
            sequence: 10
        }

        action refresh (
            name: Оновити
            action: refresh
            affectedElements {
                selectionType: region
                region: @list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
