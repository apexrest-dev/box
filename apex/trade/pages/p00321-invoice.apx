page 321 (
    name: Рахунок на оплату
    alias: INVOICE
    title: Рахунок на оплату
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-sales
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>&P321_FORM_TITLE.</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Команди
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region header (
        name: Рахунок на оплату
        title: Рахунок на оплату
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: DOC_INVOICE_FOR_PAYMENT
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P321_STATUS is not null and :P321_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    pageItem P321_ID (
        type: hidden
        layout {
            sequence: 10
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P321_DOC_NUMBER (
        type: textField
        label {
            label: Номер
            alignment: right
        }
        layout {
            sequence: 20
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @header
            column: DOC_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Порожній номер буде призначено автоматично.
        }
    )

    pageItem P321_OCCURRED_AT (
        type: datePicker
        label {
            label: Дата
            alignment: right
        }
        layout {
            sequence: 30
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: OCCURRED_AT
            dataType: date
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY HH24:MI:SS')
        }
        settings {
            displayAs: popup
            showTime: true
        }
    )

    pageItem P321_ORGANIZATION_ID (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 40
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: ORGANIZATION_ID
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trade_org.default_org
        }
        lov {
            type: sharedComponent
            lov: @organizations-active
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Від імені якої організації оформлено документ. Документ на підставі отримує організацію підстави.
        }
    )

    pageItem P321_CUSTOMER_ID (
        type: popupLov
        label {
            label: Покупець
            alignment: right
        }
        layout {
            sequence: 50
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: CUSTOMER_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @counterparties-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
    )

    pageItem P321_CONTRACT_ID (
        type: popupLov
        label {
            label: Договір
            alignment: right
        }
        layout {
            sequence: 60
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CONTRACT_ID
            dataType: varchar2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.name || case when c.contract_number is not null then ' № ' || c.contract_number end d, c.id r
                  from ref_contract c
                 where c.state = 'ACTIVE' and c.contract_kind = 'WITH_CUSTOMER'
                   and c.owner_id = :P321_CUSTOMER_ID
                 order by c.name
                ```
            displayExtraValues: true
            displayNullValue: true
        }
        cascadingLov {
            parentItems: [
                P321_CUSTOMER_ID
            ]
            parentRequired: false
        }
        help {
            helpText: Список договорів обраного контрагента. Якщо договір один — підставляється автоматично.
        }
    )

    pageItem P321_PAYMENT_DUE_DATE (
        type: datePicker
        label {
            label: Сплатити до
            alignment: right
        }
        layout {
            sequence: 70
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        source {
            formRegion: @header
            column: PAYMENT_DUE_DATE
            dataType: date
        }
        settings {
            displayAs: popup
            showTime: false
        }
    )

    pageItem P321_BASE_ORDER_ID (
        type: displayOnly
        label {
            label: Замовлення-підстава
            alignment: right
        }
        layout {
            sequence: 80
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: BASE_ORDER_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @recorders
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P321_PRICE_INCLUDES_VAT (
        type: selectList
        label {
            label: Ціни
            alignment: right
        }
        layout {
            sequence: 90
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: PRICE_INCLUDES_VAT
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @vat-price-modes
            displayExtraValues: true
            displayNullValue: true
        }
        help {
            helpText: Ціна включає ПДВ або ПДВ зверху. Порожньо — за видом цін (інакше «включає»). Зміна перераховує ПДВ рядків.
        }
    )

    pageItem P321_STATUS (
        type: hidden
        layout {
            sequence: 100
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: STATUS
            dataType: varchar2
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P321_FORM_TITLE (
        type: hidden
        layout {
            sequence: 110
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P321_NEW_ID (
        type: hidden
        layout {
            sequence: 120
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    region scan (
        name: Сканер
        type: staticContent
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P321_ID is not null and :P321_STATUS = 'DRAFT'
        }
    )

    pageItem P321_SCAN (
        type: textField
        label {
            label: Штрихкод / артикул
            alignment: right
        }
        layout {
            sequence: 10
            region: @scan
            slot: regionBody
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            valuePlaceholder: Відскануйте або введіть і натисніть «Додати»
        }
        advanced {
            customAttributes: autocomplete="off"
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    button scan (
        buttonName: SCAN
        label: Додати
        layout {
            sequence: 20
            region: @scan
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
    )

    region lines (
        name: Товари
        title: Товари
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, document_id, line_number, product_id, quantity, price, amount, vat_rate_code, vat_amount, amount_with_vat
                  from doc_invoice_for_payment_goods
                 where document_id = :P321_ID
                 order by line_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: tx-tabpart
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P321_STATUS is not null and :P321_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                actionsMenu
            ]
            addButtonLabel: Додати рядок
        }
        advanced {
            savedReportMappingIdentifier: 910000000290
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn LINE_NUMBER (
                column: @LINE_NUMBER
                layout {
                    sequence: 10
                    show: true
                    width: 50
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 380
                }
            )

            displayColumn QUANTITY (
                column: @QUANTITY
                layout {
                    sequence: 30
                    show: true
                    width: 130
                }
            )

            displayColumn PRICE (
                column: @PRICE
                layout {
                    sequence: 40
                    show: true
                    width: 130
                }
            )

            displayColumn AMOUNT (
                column: @AMOUNT
                layout {
                    sequence: 50
                    show: true
                    width: 140
                }
            )

            displayColumn VAT_RATE_CODE (
                column: @VAT_RATE_CODE
                layout {
                    sequence: 60
                    show: true
                    width: 130
                }
            )

            displayColumn VAT_AMOUNT (
                column: @VAT_AMOUNT
                layout {
                    sequence: 70
                    show: true
                    width: 110
                }
            )

            displayColumn AMOUNT_WITH_VAT (
                column: @AMOUNT_WITH_VAT
                layout {
                    sequence: 80
                    show: true
                    width: 120
                }
            )
        )

        column ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: ID
                dataType: varchar2
                primaryKey: true
            }
            layout {
                sequence: 10
            }
        )

        column DOCUMENT_ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: DOCUMENT_ID
                dataType: varchar2
            }
            layout {
                sequence: 20
            }
        )

        column LINE_NUMBER (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: LINE_NUMBER
                dataType: number
            }
            heading {
                heading: N
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column PRODUCT_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: PRODUCT_ID
                dataType: varchar2
            }
            heading {
                heading: Товар
                alignment: start
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @products-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
        )

        column QUANTITY (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: QUANTITY
                dataType: number
            }
            heading {
                heading: Кількість
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column PRICE (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: PRICE
                dataType: number
            }
            heading {
                heading: Ціна
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Сума
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column VAT_RATE_CODE (
            type: selectList
            source {
                type: databaseColumn
                databaseColumn: VAT_RATE_CODE
                dataType: varchar2
            }
            heading {
                heading: Ставка ПДВ
                alignment: start
            }
            layout {
                sequence: 80
            }
            lov {
                type: sharedComponent
                lov: @vat-rates
                displayExtraValues: true
                displayNullValue: true
            }
            help {
                helpText: Порожньо — ставка товару (організація / постачальник не платник — «Без ПДВ»).
            }
        )

        column VAT_AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: VAT_AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Сума ПДВ
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column AMOUNT_WITH_VAT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: AMOUNT_WITH_VAT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Всього
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )
    )

    region invoice-payments (
        name: Оплати за рахунком
        title: Оплати за рахунком
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select doc_kind, doc_number, occurred_at, payment_form_name, amount,
                       case status when 'POSTED' then 'Проведено' else 'Чернетка' end status_name
                  from v_invoice_payment
                 where invoice_id = :P321_ID
                ```
        }
        layout {
            sequence: 45
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000291
        }


        column DOC_KIND (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Документ
            }
            layout {
                sequence: 10
            }
        )

        column DOC_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Номер
            }
            layout {
                sequence: 20
            }
        )

        column OCCURRED_AT (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата
            }
            layout {
                sequence: 30
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
        )

        column PAYMENT_FORM_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Форма оплати
            }
            layout {
                sequence: 40
            }
        )

        column AMOUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Сума
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column STATUS_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Стан
            }
            layout {
                sequence: 60
            }
        )
    )

    region cargo (
        name: Вага й об'єм
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return trade_cargo.summary_html('DocInvoiceForPayment', :P321_ID);
                ```
        }
        layout {
            sequence: 38
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P321_ID
        }
    )

    region footer (
        name: Підвал
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P321_VAT_AMOUNT (
        type: displayOnly
        label {
            label: Сума ПДВ
            alignment: right
        }
        layout {
            sequence: 130
            region: @footer
            slot: regionBody
            columnSpan: 3
            column: 7
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: VAT_AMOUNT
            dataType: number
        }
    )

    pageItem P321_TOTAL_AMOUNT (
        type: displayOnly
        label {
            label: Всього
            alignment: right
        }
        layout {
            sequence: 140
            region: @footer
            slot: regionBody
            columnSpan: 3
            startNewRow: false
            column: 10
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: TOTAL_AMOUNT
            dataType: number
        }
    )

    pageItem P321_DOC_COMMENT (
        type: textarea
        label {
            label: Коментар
            alignment: right
        }
        layout {
            sequence: 150
            region: @footer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @header
            column: DOC_COMMENT
            dataType: varchar2
        }
        settings {
            resizable: true
            autoHeight: false
            charCounter: true
            trimSpaces: leadingAndTrailing
        }
    )

    pageItem P321_CANCEL_TEXT (
        type: textField
        label {
            label: Причина анулювання
            alignment: right
        }
        layout {
            sequence: 160
            region: @footer
            slot: regionBody
            columnSpan: 8
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
        serverSideCondition {
            type: item=value
            item: P321_STATUS
            value: ISSUED
        }
    )

    process form-title (
        name: Заголовок форми
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P321_FORM_TITLE := trade_ui.doc_title('Рахунок на оплату', :P321_DOC_NUMBER, :P321_OCCURRED_AT, :P321_STATUS);
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000292
        }
    )

    button create-post-close (
        buttonName: CREATE_POST_CLOSE
        label: Видати і закрити
        layout {
            sequence: 10
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P321_ID
        }
    )

    button post-close (
        buttonName: POST_CLOSE
        label: Видати і закрити
        layout {
            sequence: 11
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P321_ID is not null and :P321_STATUS = 'DRAFT'
        }
    )

    button create (
        buttonName: CREATE
        label: Записати
        layout {
            sequence: 20
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P321_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Записати
        layout {
            sequence: 21
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P321_ID is not null and :P321_STATUS = 'DRAFT'
        }
    )

    button create-post (
        buttonName: CREATE_POST
        label: Видати
        layout {
            sequence: 30
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
