    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @header
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000293
        }
    )

    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000294
        }
    )

    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_invoice_for_payment_goods (document_id, line_number, product_id, quantity, price, vat_rate_code)
                    values (:P321_ID, null,
                            :PRODUCT_ID,
                            to_number(:QUANTITY, 'FM999G999G999G990D000'),
                            to_number(:PRICE, 'FM999G999G999G990D00'),
                            :VAT_RATE_CODE)
                    returning id into :ID;
                  when 'U' then
                    update doc_invoice_for_payment_goods
                       set product_id = :PRODUCT_ID,
                           quantity = to_number(:QUANTITY, 'FM999G999G999G990D000'),
                           price = to_number(:PRICE, 'FM999G999G999G990D00'),
                           vat_rate_code = :VAT_RATE_CODE
                     where id = :ID and document_id = :P321_ID;
                  when 'D' then
                    delete from doc_invoice_for_payment_goods where id = :ID and document_id = :P321_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000295
        }
    )

    process post (
        name: Провести
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_warn.clear;
                trade_r3.issue_invoice(:P321_ID);
                :TRADE_WARN := trade_warn.take;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Рахунок видано. &TRADE_WARN.
        }
        advanced {
            executionMappingIdentifier: 910000000296
        }
    )

    process unpost (
        name: Скасувати проведення
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_r3.invoice_to_draft(:P321_ID);
                ```
        }
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @unpost
        }
        successMessage {
            successMessage: Проведення документа скасовано.
        }
        advanced {
            executionMappingIdentifier: 910000000297
        }
    )

    process copy (
        name: Скопіювати
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_src varchar2(32) := :P321_ID;
                begin
                  :P321_ID := trade_r3.copy_invoice(l_src);
                  trade_vat.copy_lines('DocInvoiceForPayment', l_src, :P321_ID);
                end;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @copy
        }
        successMessage {
            successMessage: Створено копію документа (чернетка).
        }
        advanced {
            executionMappingIdentifier: 910000000298
        }
    )

