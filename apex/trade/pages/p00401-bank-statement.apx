    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @header
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000315
        }
    )

    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000316
        }
    )

    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_bank_statement_line (document_id, line_number, operation_kind, amount, counterparty_id, contract_id, purpose, cp_name, cp_edrpou, cp_iban, ext_doc_number, cash_order_id, payment_doc_id)
                    values (:P401_ID, null,
                            :OPERATION_KIND,
                            to_number(:AMOUNT, 'FM999G999G999G990D00'),
                            :COUNTERPARTY_ID,
                            :CONTRACT_ID,
                            :PURPOSE,
                            :CP_NAME,
                            :CP_EDRPOU,
                            :CP_IBAN,
                            :EXT_DOC_NUMBER,
                            :CASH_ORDER_ID,
                            :PAYMENT_DOC_ID)
                    returning id into :ID;
                  when 'U' then
                    update doc_bank_statement_line
                       set operation_kind = :OPERATION_KIND,
                           amount = to_number(:AMOUNT, 'FM999G999G999G990D00'),
                           counterparty_id = :COUNTERPARTY_ID,
                           contract_id = :CONTRACT_ID,
                           purpose = :PURPOSE,
                           cp_name = :CP_NAME,
                           cp_edrpou = :CP_EDRPOU,
                           cp_iban = :CP_IBAN,
                           ext_doc_number = :EXT_DOC_NUMBER,
                           cash_order_id = :CASH_ORDER_ID,
                           payment_doc_id = :PAYMENT_DOC_ID
                     where id = :ID and document_id = :P401_ID;
                  when 'D' then
                    delete from doc_bank_statement_line where id = :ID and document_id = :P401_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000317
        }
    )

    process post (
        name: Провести
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_warn.clear;
                trade_bank_doc.post(:P401_ID);
                :TRADE_WARN := trade_warn.take;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ проведено. &TRADE_WARN.
        }
        advanced {
            executionMappingIdentifier: 910000000318
        }
    )

