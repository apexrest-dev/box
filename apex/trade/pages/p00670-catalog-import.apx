page 670 (
    name: Імпорт довідників
    alias: CATALOG-IMPORT
    title: Імпорт довідників
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-admin
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Імпорт довідників</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region params (
        name: 1. Файл і параметри
        title: 1. Файл і параметри
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P670_KIND (
        type: selectList
        label {
            label: Що завантажувати
            alignment: right
        }
        layout {
            sequence: 10
            region: @params
            slot: regionBody
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @import-kinds
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: — виберіть довідник —
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P670_MODE (
        type: selectList
        label {
            label: Режим
            alignment: right
        }
        layout {
            sequence: 20
            region: @params
            slot: regionBody
            columnSpan: 4
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @import-modes
            displayExtraValues: false
            displayNullValue: false
        }
        default {
            type: static
            staticValue: CREATE_UPDATE
        }
        help {
            helpText: Існуючі елементи шукаються за кодом, далі — за артикулом / штрихкодом (номенклатура), ЄДРПОУ (контрагенти), скороченням (одиниці), назвою в межах батьківської групи (групи). Порожня клітинка під час оновлення не змінює значення.
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P670_CHARSET (
        type: selectList
        label {
            label: Кодування CSV
            alignment: right
        }
        layout {
            sequence: 30
            region: @params
            slot: regionBody
            columnSpan: 4
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @import-charsets
            displayExtraValues: false
            displayNullValue: false
        }
        default {
            type: static
            staticValue: AL32UTF8
        }
        help {
            helpText: Для XLSX не має значення. CSV, збережений з Excel «CSV (роздільники — коми)», зазвичай у Windows-1251.
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P670_PRICE_TYPE (
        type: selectList
        label {
            label: Вид цін
            alignment: right
