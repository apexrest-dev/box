    region history (
        name: Історія імпорту
        title: Історія імпорту
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, cast(created_at as date) created_at, created_by, kind_name, file_name, mode_name, status_name,
                       total_rows, created_cnt, updated_cnt, price_cnt, skipped_cnt, error_cnt
                  from v_import_session
                 order by created_at desc
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 670
                clearCache: 670
                items: {
                    P670_SESSION: #ID#
                }
