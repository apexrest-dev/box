    process init (
        name: Параметри сеансу імпорту
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                for s in (select * from sys_import_session where id = :P670_SESSION) loop
                  :P670_KIND := s.import_kind;
                  :P670_MODE := s.import_mode;
                  :P670_PRICE_TYPE := s.price_type_id;
                  :P670_PRICE_DATE := to_char(s.price_date, 'DD.MM.YYYY');
                  :P670_STATUS := s.status;
                end loop;
                if :P670_STATUS is null then
                  :P670_SESSION := null;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000473
        }
    )

    process kind (
        name: Змінити довідник
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P670_SESSION := null;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('KIND')
        }
        advanced {
            executionMappingIdentifier: 910000000474
        }
    )

    process load (
        name: Завантажити файл
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_blob blob;
                  l_name varchar2(400);
                begin
                  select max(blob_content), max(filename) into l_blob, l_name from apex_application_temp_files where name = :P670_FILE;
                  if l_blob is null then
                    trade_nsi.fail('IMPORT_FILE_EMPTY', 'Виберіть файл для завантаження.');
                  end if;
                  :P670_SESSION := trade_import.load_file(:P670_KIND, :P670_MODE, l_name, l_blob, :P670_CHARSET,
                                                       :P670_PRICE_TYPE, to_date(:P670_PRICE_DATE, 'DD.MM.YYYY'));
                  begin
                    trade_import.check_rows(:P670_SESSION);
                  exception when others then
                    null;   -- обов'язкові колонки не зіставлено: користувач зіставить вручну
                  end;
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('LOAD')
        }
        successMessage {
            successMessage: Файл завантажено. Перевірте зіставлення колонок і рядки, потім натисніть «Виконати імпорт».
        }
        advanced {
            executionMappingIdentifier: 910000000475
        }
    )

    process check (
        name: Зіставлення й перевірка
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                for i in 1 .. apex_application.g_f02.count loop
                  trade_import.set_mapping(:P670_SESSION, to_number(apex_application.g_f02(i)), apex_application.g_f01(i));
                end loop;
                trade_import.set_options(:P670_SESSION, :P670_MODE, :P670_PRICE_TYPE, to_date(:P670_PRICE_DATE, 'DD.MM.YYYY'));
                trade_import.check_rows(:P670_SESSION);
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CHECK')
        }
        successMessage {
            successMessage: Перевірку виконано.
        }
        advanced {
            executionMappingIdentifier: 910000000476
        }
    )

    process apply (
        name: Виконати імпорт
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_import.apply(:P670_SESSION);
                ```
        }
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('APPLY')
        }
        successMessage {
            successMessage: Імпорт виконано. Результат кожного рядка — у таблиці «Рядки файлу».
        }
        advanced {
            executionMappingIdentifier: 910000000477
        }
    )

    process template (
        name: Шаблон CSV
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_import.download_template(:P670_KIND);
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('TEMPLATE')
        }
        advanced {
            executionMappingIdentifier: 910000000478
        }
    )

    process errors (
        name: Звіт помилок
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_import.download_errors(:P670_SESSION);
                ```
        }
        execution {
            sequence: 60
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('ERRORS')
        }
        advanced {
            executionMappingIdentifier: 910000000479
        }
    )

    process new (
        name: Новий імпорт
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P670_SESSION := null;
                ```
        }
        execution {
            sequence: 70
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('NEW')
        }
        advanced {
            executionMappingIdentifier: 910000000480
        }
    )

    branch stay (
        name: Залишитися
        behavior {
            type: pageOrUrl
            target: {
                page: 670
            }
        }
        execution {
            sequence: 10
            point: afterProcessing
        }
    )
)
