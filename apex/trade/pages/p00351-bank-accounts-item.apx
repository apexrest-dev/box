page 351 (
    name: Банківський рахунок
    alias: BANK-ACCOUNTS-ITEM
    title: Банківський рахунок
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 720
        chained: false
    }
    security {
        authorizationScheme: @role-cashier
    }

    region form (
        name: Банківський рахунок
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: REF_BANK_ACCOUNT
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    region buttons (
        name: Кнопки
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P351_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P351_CODE (
        type: textField
        label {
            label: Код
            alignment: right
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @form
            column: CODE
            dataType: varchar2
        }
        help {
            helpText: Порожній код буде призначено автоматично.
        }
    )

    pageItem P351_NAME (
        type: textField
        label {
            label: Найменування
            alignment: right
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            columnSpan: 9
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form
            column: NAME
            dataType: varchar2
        }
        help {
            helpText: Порожнє — «Банк, валюта …4 останні цифри IBAN».
        }
    )

    pageItem P351_ORGANIZATION_ID (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ORGANIZATION_ID
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trade_org.default_org
        }
        lov {
            type: sharedComponent
            lov: @organizations-active
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Організація — власник каси або рахунку.
        }
    )

    pageItem P351_CURRENCY_CODE (
        type: selectList
        label {
            label: Валюта
            alignment: right
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: CURRENCY_CODE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: UAH
        }
        lov {
            type: sharedComponent
            lov: @currencies
            displayExtraValues: true
            displayNullValue: false
        }
    )

    pageItem P351_IBAN (
        type: textField
        label {
            label: IBAN
            alignment: right
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            columnSpan: 8
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 40
            valueRequired: true
        }
        source {
            formRegion: @form
            column: IBAN
            dataType: varchar2
        }
        help {
            helpText: UA + 27 цифр; пробіли прибираються, контрольна сума перевіряється (ISO 13616, mod 97).
        }
    )

    pageItem P351_MFO (
        type: textField
        label {
            label: МФО
            alignment: right
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            columnSpan: 4
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 6
        }
        source {
            formRegion: @form
            column: MFO
            dataType: varchar2
        }
        help {
            helpText: Код банку; порожнє — береться з IBAN (позиції 5–10).
        }
    )

    pageItem P351_BANK_NAME (
        type: textField
        label {
            label: Банк
            alignment: right
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
            valueRequired: true
        }
        source {
            formRegion: @form
            column: BANK_NAME
            dataType: varchar2
        }
    )

    pageItem P351_IS_DEFAULT (
        type: switch
        label {
            label: Основний рахунок організації
            alignment: right
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: IS_DEFAULT
            dataType: varchar2
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Так
            offValue: N
            offLabel: Ні
        }
        help {
            helpText: Один основний рахунок на організацію й валюту: нова ознака знімає попередню.
        }
    )

    pageItem P351_NOTE (
        type: textarea
        label {
            label: Коментар
            alignment: right
        }
        layout {
            sequence: 100
            region: @form
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: NOTE
            dataType: varchar2
        }
        settings {
            resizable: true
            autoHeight: false
            charCounter: true
            trimSpaces: leadingAndTrailing
        }
    )

    pageItem P351_STATE (
        type: displayOnly
        label {
            label: Стан
            alignment: right
        }
        layout {
            sequence: 110
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: STATE
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @catalog-states
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Скасувати
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button mark (
        buttonName: MARK
        label: Помітити на видалення
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Помітити елемент на видалення?
            style: warning
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P351_ID is not null and :P351_STATE = 'ACTIVE'
        }
        security {
            authorizationScheme: @role-cashier
        }
    )

    button restore (
        buttonName: RESTORE
        label: Відновити
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P351_STATE = 'MARKED_FOR_DELETION'
        }
        security {
            authorizationScheme: @role-cashier
        }
    )

    button save (
        buttonName: SAVE
        label: Записати і закрити
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P351_ID
        }
        security {
            authorizationScheme: @role-cashier
        }
    )

    button create (
        buttonName: CREATE
        label: Записати і закрити
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P351_ID
        }
        security {
            authorizationScheme: @role-cashier
        }
    )

    dynamicAction cancel-dialog (
        name: Скасувати діалог
        when {
            event: click
            selectionType: button
            button: @cancel
        }
        execution {
            sequence: 10
        }

        action cancel-dialog (
            name: Закрити
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000056
        }
    )

    process dml (
        name: Записати
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('SAVE', 'CREATE')
        }
        successMessage {
            successMessage: Елемент записано.
        }
        advanced {
            executionMappingIdentifier: 910000000057
        }
    )

    process mark (
        name: Помітити на видалення
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_core.mark_for_deletion('REF_BANK_ACCOUNT', :P351_ID);
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @mark
        }
        advanced {
            executionMappingIdentifier: 910000000058
        }
    )

    process restore (
        name: Відновити
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_core.restore('REF_BANK_ACCOUNT', :P351_ID);
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @restore
        }
        advanced {
            executionMappingIdentifier: 910000000059
        }
    )

    process close (
        name: Закрити діалог
        type: closeDialog
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('SAVE', 'CREATE', 'MARK', 'RESTORE')
        }
        advanced {
            executionMappingIdentifier: 910000000060
        }
    )
)
