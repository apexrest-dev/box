page 190 (
    name: Штрихкоди номенклатури
    alias: BARCODES
    title: Штрихкоди номенклатури
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-warehouse
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Штрихкоди номенклатури</h1></div>
        }
        layout {
            sequence: 0
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region grid (
        name: Штрихкоди номенклатури
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, barcode, product_id, unit_quantity
                  from reg_barcode
                 order by barcode
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                searchField
                actionsMenu
                saveButton
            ]
            addButtonLabel: Додати
        }
        advanced {
            savedReportMappingIdentifier: 910000000417
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn BARCODE (
                column: @BARCODE
                layout {
                    sequence: 10
                    show: true
                    width: 180
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 320
                }
            )

            displayColumn UNIT_QUANTITY (
                column: @UNIT_QUANTITY
                layout {
                    sequence: 30
                    show: true
                    width: 140
                }
            )
        )

        column ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: ID
                dataType: varchar2
                primaryKey: true
            }
            layout {
                sequence: 5
            }
        )

        column BARCODE (
            type: textField
            source {
                type: databaseColumn
                databaseColumn: BARCODE
                dataType: varchar2
                }
            heading {
                heading: Штрихкод
                alignment: start
            }
            layout {
                sequence: 10
            }
            validation {
                valueRequired: true
            }
        )

        column PRODUCT_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: PRODUCT_ID
                dataType: varchar2
            }
            heading {
                heading: Товар
                alignment: start
            }
            layout {
                sequence: 20
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @products-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
        )

        column UNIT_QUANTITY (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: UNIT_QUANTITY
                dataType: number
            }
            heading {
                heading: Кількість в упаковці
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )
    )

    process dml (
        name: Записати
        type: interactiveGridAutoRowProcessing
        editableRegion: @grid
        target {
            targetType: tableView
            tableName: REG_BARCODE
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 910000000418
        }
    )
)
