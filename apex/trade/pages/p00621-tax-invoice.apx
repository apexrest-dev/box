page 621 (
    name: Податкова накладна
    alias: TAX-INVOICE
    title: Податкова накладна
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-tax
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>&P621_FORM_TITLE.</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Команди
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region header (
        name: Податкова накладна
        title: Податкова накладна
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: DOC_TAX_INVOICE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P621_STATUS is not null and :P621_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    pageItem P621_ID (
        type: hidden
        layout {
            sequence: 10
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P621_DOC_NUMBER (
        type: textField
        label {
            label: Номер
            alignment: right
        }
        layout {
            sequence: 20
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @header
            column: DOC_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Порожній номер буде призначено автоматично.
        }
    )

    pageItem P621_OCCURRED_AT (
        type: datePicker
        label {
            label: Дата
            alignment: right
        }
        layout {
            sequence: 30
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: OCCURRED_AT
            dataType: date
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY HH24:MI:SS')
        }
        settings {
            displayAs: popup
            showTime: true
        }
    )

    pageItem P621_ORGANIZATION_ID (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 40
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: ORGANIZATION_ID
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trade_org.default_org
        }
        lov {
            type: sharedComponent
            lov: @organizations-active
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Від імені якої організації оформлено документ. Документ на підставі отримує організацію підстави.
        }
    )

    pageItem P621_DIRECTION (
        type: selectList
        label {
            label: Вид
            alignment: right
        }
        layout {
            sequence: 50
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: DIRECTION
            dataType: varchar2
        }
        default {
            type: static
            staticValue: ISSUED
        }
        lov {
            type: sharedComponent
            lov: @tax-directions
            displayExtraValues: true
            displayNullValue: false
        }
    )

    pageItem P621_COUNTERPARTY_ID (
        type: popupLov
        label {
            label: Контрагент
            alignment: right
        }
        layout {
            sequence: 60
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: COUNTERPARTY_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @counterparties-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
        help {
            helpText: Покупець (видана ПН) або постачальник (отримана ПН).
        }
    )

    pageItem P621_CONTRACT_ID (
        type: popupLov
        label {
            label: Договір
            alignment: right
        }
        layout {
            sequence: 70
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CONTRACT_ID
            dataType: varchar2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.name || ': ' || c.name || case when c.contract_number is not null then ' № ' || c.contract_number end d, c.id r
                  from ref_contract c join ref_counterparty o on o.id = c.owner_id
                 where c.state = 'ACTIVE' and c.owner_id = :P621_COUNTERPARTY_ID
                 order by c.name
                ```
            displayExtraValues: true
            displayNullValue: true
        }
        cascadingLov {
            parentItems: [
                P621_COUNTERPARTY_ID
            ]
            parentRequired: false
        }
    )

    pageItem P621_EVENT_KIND (
        type: displayOnly
        label {
            label: Перша подія
            alignment: right
        }
        layout {
            sequence: 80
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: EVENT_KIND
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @tax-event-kinds
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P621_BASE_DOC_ID (
        type: displayOnly
        label {
            label: Підстава
            alignment: right
        }
        layout {
            sequence: 90
            region: @header
            slot: regionBody
            columnSpan: 9
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: BASE_DOC_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @recorders
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P621_EXT_NUMBER (
        type: textField
        label {
            label: № ПН постачальника
            alignment: right
        }
        layout {
            sequence: 100
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @header
            column: EXT_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Для отриманої ПН — порядковий номер податкової накладної постачальника (обов'язковий для проведення).
        }
    )

    pageItem P621_NOT_ISSUED_REASON (
        type: selectList
        label {
            label: Не видається покупцю (тип причини)
            alignment: right
        }
        layout {
            sequence: 110
            region: @header
            slot: regionBody
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: NOT_ISSUED_REASON
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @tax-not-issued-reasons
            displayExtraValues: true
            displayNullValue: true
        }
        help {
            helpText: Заповнюється автоматично: 02 — покупець не платник ПДВ, 07 — експорт (усі рядки 0 %).
        }
    )

    pageItem P621_BUYER_VAT_NUMBER (
        type: displayOnly
        label {
            label: ІПН покупця
            alignment: right
        }
        layout {
            sequence: 120
            region: @header
            slot: regionBody
            columnSpan: 2
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: BUYER_VAT_NUMBER
            dataType: varchar2
        }
    )

    pageItem P621_SELLER_VAT_NUMBER (
        type: displayOnly
        label {
            label: ІПН продавця
            alignment: right
        }
        layout {
            sequence: 130
            region: @header
            slot: regionBody
            columnSpan: 2
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: SELLER_VAT_NUMBER
            dataType: varchar2
        }
    )

    pageItem P621_ERPN_STATUS (
        type: displayOnly
        label {
            label: Стан ЄРПН
            alignment: right
        }
        layout {
            sequence: 140
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: ERPN_STATUS
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @tax-erpn-statuses
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P621_ERPN_REG_NUMBER (
        type: displayOnly
        label {
            label: Реєстраційний № ЄРПН
            alignment: right
        }
        layout {
            sequence: 150
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: ERPN_REG_NUMBER
            dataType: varchar2
        }
    )

    pageItem P621_ERPN_REG_DATE (
        type: displayOnly
        label {
            label: Дата реєстрації
            alignment: right
        }
        layout {
            sequence: 160
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        source {
            formRegion: @header
            column: ERPN_REG_DATE
            dataType: date
        }
    )

    pageItem P621_AMOUNT_WITHOUT_VAT (
        type: displayOnly
        label {
            label: Обсяг без ПДВ
            alignment: right
        }
        layout {
            sequence: 170
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: AMOUNT_WITHOUT_VAT
            dataType: number
        }
    )

    pageItem P621_STATUS (
        type: hidden
        layout {
            sequence: 180
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: STATUS
            dataType: varchar2
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P621_FORM_TITLE (
        type: hidden
        layout {
            sequence: 190
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P621_NEW_ID (
        type: hidden
        layout {
            sequence: 200
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    region lines (
        name: Товари / послуги
        title: Товари / послуги
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, document_id, line_number, product_id, description, uktzed_code, unit_name, quantity, price, vat_rate_code, amount, vat_amount
                  from doc_tax_invoice_goods
                 where document_id = :P621_ID
                 order by line_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: tx-tabpart
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P621_STATUS is not null and :P621_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                actionsMenu
            ]
            addButtonLabel: Додати рядок
        }
        advanced {
            savedReportMappingIdentifier: 910000000372
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn LINE_NUMBER (
                column: @LINE_NUMBER
                layout {
                    sequence: 10
                    show: true
                    width: 50
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 260
                }
            )

            displayColumn DESCRIPTION (
                column: @DESCRIPTION
                layout {
                    sequence: 30
                    show: true
                    width: 300
                }
            )

            displayColumn UKTZED_CODE (
                column: @UKTZED_CODE
                layout {
                    sequence: 40
                    show: true
                    width: 110
                }
            )

            displayColumn UNIT_NAME (
                column: @UNIT_NAME
                layout {
                    sequence: 50
                    show: true
                    width: 60
                }
            )

            displayColumn QUANTITY (
                column: @QUANTITY
                layout {
                    sequence: 60
                    show: true
                    width: 130
                }
            )

            displayColumn PRICE (
                column: @PRICE
                layout {
                    sequence: 70
                    show: true
                    width: 130
                }
            )

            displayColumn VAT_RATE_CODE (
                column: @VAT_RATE_CODE
                layout {
                    sequence: 80
                    show: true
                    width: 130
                }
            )

            displayColumn AMOUNT (
                column: @AMOUNT
                layout {
                    sequence: 90
                    show: true
                    width: 130
                }
            )

            displayColumn VAT_AMOUNT (
                column: @VAT_AMOUNT
                layout {
                    sequence: 100
                    show: true
                    width: 110
                }
            )
        )

        column ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: ID
                dataType: varchar2
                primaryKey: true
            }
            layout {
                sequence: 10
            }
        )

        column DOCUMENT_ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: DOCUMENT_ID
                dataType: varchar2
            }
            layout {
                sequence: 20
            }
        )

        column LINE_NUMBER (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: LINE_NUMBER
                dataType: number
            }
            heading {
                heading: N
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column PRODUCT_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: PRODUCT_ID
                dataType: varchar2
            }
            heading {
                heading: Товар
                alignment: start
            }
            layout {
                sequence: 40
            }
            lov {
                type: sharedComponent
                lov: @products-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
            help {
                helpText: Необов'язково: опис, код УКТ ЗЕД, одиниця й ставка підставляються з товару.
            }
        )

        column DESCRIPTION (
            type: textField
            source {
                type: databaseColumn
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
            heading {
                heading: Опис постачання
                alignment: start
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 500
            }
        )

        column UKTZED_CODE (
            type: textField
            source {
                type: databaseColumn
                databaseColumn: UKTZED_CODE
                dataType: varchar2
            }
            heading {
                heading: УКТ ЗЕД / ДКПП
                alignment: start
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 10
            }
        )

        column UNIT_NAME (
            type: textField
            source {
                type: databaseColumn
                databaseColumn: UNIT_NAME
                dataType: varchar2
            }
            heading {
                heading: Од.
                alignment: start
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 20
            }
        )

        column QUANTITY (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: QUANTITY
                dataType: number
            }
            heading {
                heading: Кількість
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column PRICE (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: PRICE
                dataType: number
            }
            heading {
                heading: Ціна без ПДВ
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column VAT_RATE_CODE (
            type: selectList
            source {
                type: databaseColumn
                databaseColumn: VAT_RATE_CODE
                dataType: varchar2
            }
            heading {
                heading: Ставка ПДВ
                alignment: start
            }
            layout {
                sequence: 100
            }
            lov {
                type: sharedComponent
                lov: @vat-rates-product
                displayExtraValues: true
                displayNullValue: true
            }
        )

        column AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Обсяг без ПДВ
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column VAT_AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: VAT_AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Сума ПДВ
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )
    )

    region footer (
        name: Підвал
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P621_VAT_AMOUNT (
        type: displayOnly
        label {
            label: Сума ПДВ
            alignment: right
        }
        layout {
            sequence: 210
            region: @footer
            slot: regionBody
            columnSpan: 3
            column: 7
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: VAT_AMOUNT
            dataType: number
        }
    )

    pageItem P621_TOTAL_AMOUNT (
        type: displayOnly
        label {
            label: Всього
            alignment: right
        }
        layout {
            sequence: 220
            region: @footer
            slot: regionBody
            columnSpan: 3
            startNewRow: false
            column: 10
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: TOTAL_AMOUNT
            dataType: number
        }
    )

    pageItem P621_DOC_COMMENT (
        type: textarea
        label {
            label: Коментар
            alignment: right
        }
        layout {
            sequence: 230
            region: @footer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @header
            column: DOC_COMMENT
            dataType: varchar2
        }
        settings {
            resizable: true
            autoHeight: false
            charCounter: true
            trimSpaces: leadingAndTrailing
        }
    )

    pageItem P621_ERPN_NUMBER (
        type: textField
        label {
            label: Реєстраційний № ЄРПН
            alignment: right
        }
        layout {
            sequence: 240
            region: @footer
            slot: regionBody
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
        serverSideCondition {
            type: item=value
            item: P621_STATUS
            value: POSTED
        }
    )

    process form-title (
        name: Заголовок форми
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P621_FORM_TITLE := trade_ui.doc_title('Податкова накладна', :P621_DOC_NUMBER, :P621_OCCURRED_AT, :P621_STATUS);
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000373
        }
    )

    button create-post-close (
        buttonName: CREATE_POST_CLOSE
        label: Провести і закрити
        layout {
            sequence: 10
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
