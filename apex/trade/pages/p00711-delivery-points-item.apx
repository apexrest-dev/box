page 711 (
    name: Точка доставки
    alias: DELIVERY-POINTS-ITEM
    title: Точка доставки
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        chained: false
    }
    security {
        authorizationScheme: @role-sales
    }

    region form (
        name: Точка доставки
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: REF_DELIVERY_POINT
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    region buttons (
        name: Кнопки
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P711_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P711_CODE (
        type: textField
        label {
            label: Код
            alignment: right
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @form
            column: CODE
            dataType: varchar2
        }
        help {
            helpText: Порожній код буде призначено автоматично.
        }
    )

    pageItem P711_NAME (
        type: textField
        label {
            label: Найменування
            alignment: right
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            columnSpan: 9
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
            valueRequired: true
        }
        source {
            formRegion: @form
            column: NAME
            dataType: varchar2
        }
        help {
            helpText: Магазин або розподільчий центр мережі.
        }
    )

    pageItem P711_COUNTERPARTY_ID (
        type: popupLov
        label {
            label: Контрагент (мережа)
            alignment: right
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: COUNTERPARTY_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @counterparties-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
    )

    pageItem P711_GLN (
        type: textField
        label {
            label: GLN точки доставки
            alignment: right
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 13
            valueRequired: true
        }
        source {
            formRegion: @form
            column: GLN
            dataType: varchar2
        }
        help {
            helpText: DELIVERYPLACE у повідомленнях ORDERS / DESADV / INVOIC / RECADV. 13 цифр з контрольною цифрою.
        }
    )

    pageItem P711_ADDRESS (
        type: textField
        label {
            label: Адреса
            alignment: right
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @form
            column: ADDRESS
            dataType: varchar2
        }
    )

    pageItem P711_WAREHOUSE_ID (
        type: popupLov
        label {
            label: Склад відвантаження
            alignment: right
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: WAREHOUSE_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @warehouses-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
        help {
            helpText: Склад нових замовлень клієнта з EDI для цієї точки. Порожньо — перший активний склад.
        }
    )

    pageItem P711_PRICE_TYPE_ID (
        type: popupLov
        label {
            label: Вид цін
            alignment: right
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: PRICE_TYPE_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @price-types-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
        help {
            helpText: Ціни замовлень з EDI. Порожньо — вид цін договору, інакше ціна з файлу мережі.
        }
    )

    pageItem P711_NOTE (
        type: textarea
        label {
            label: Коментар
            alignment: right
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @form
            column: NOTE
            dataType: varchar2
        }
        settings {
            resizable: true
            autoHeight: false
            charCounter: true
            trimSpaces: leadingAndTrailing
        }
    )

    pageItem P711_STATE (
        type: displayOnly
        label {
            label: Стан
            alignment: right
        }
        layout {
            sequence: 100
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: STATE
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @catalog-states
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Скасувати
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button mark (
        buttonName: MARK
        label: Помітити на видалення
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Помітити елемент на видалення?
            style: warning
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P711_ID is not null and :P711_STATE = 'ACTIVE'
        }
        security {
            authorizationScheme: @role-sales
        }
    )

    button restore (
        buttonName: RESTORE
        label: Відновити
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P711_STATE = 'MARKED_FOR_DELETION'
        }
        security {
            authorizationScheme: @role-sales
        }
    )

    button save (
        buttonName: SAVE
        label: Записати і закрити
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P711_ID
        }
        security {
            authorizationScheme: @role-sales
        }
    )

    button create (
        buttonName: CREATE
        label: Записати і закрити
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P711_ID
        }
        security {
            authorizationScheme: @role-sales
        }
    )

    dynamicAction cancel-dialog (
        name: Скасувати діалог
        when {
            event: click
            selectionType: button
            button: @cancel
        }
        execution {
            sequence: 10
        }

        action cancel-dialog (
            name: Закрити
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000106
        }
    )

    process dml (
        name: Записати
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('SAVE', 'CREATE')
        }
        successMessage {
            successMessage: Елемент записано.
        }
        advanced {
            executionMappingIdentifier: 910000000107
        }
    )

    process mark (
        name: Помітити на видалення
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_core.mark_for_deletion('REF_DELIVERY_POINT', :P711_ID);
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @mark
        }
        advanced {
            executionMappingIdentifier: 910000000108
        }
    )

    process restore (
        name: Відновити
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_core.restore('REF_DELIVERY_POINT', :P711_ID);
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @restore
        }
        advanced {
            executionMappingIdentifier: 910000000109
        }
    )

    process close (
        name: Закрити діалог
        type: closeDialog
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('SAVE', 'CREATE', 'MARK', 'RESTORE')
        }
        advanced {
            executionMappingIdentifier: 910000000110
        }
    )
)
