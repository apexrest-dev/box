page 620 (
    name: Податкові накладні
    alias: TAX-INVOICES
    title: Податкові накладні
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-tax
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Податкові накладні</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region list (
        name: Податкові накладні
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.id, case when d.status in ('POSTED', 'ISSUED') then 'fa-file-text-o tx-ico-posted' when d.status = 'CANCELLED' then 'fa-times tx-ico-marked' else 'fa-file-o tx-ico-draft' end icon_class, ' ' state_icon, d.doc_number, d.occurred_at, d.organization_name, d.direction_name, d.counterparty_name, d.event_name, d.base_name, d.ext_number, d.amount_without_vat, d.vat_amount, d.total_amount, d.erpn_status_name, d.erpn_reg_number, d.erpn_deadline, d.erpn_overdue, case d.status when 'POSTED' then 'Проведено' else 'Чернетка' end status_name, d.doc_comment
                  from v_tax_invoice_list d
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 621
                clearCache: 621
                items: {
                    P621_ID: #ID#
                }
            }
            linkIcon: <span class="fa fa-file-text-o" aria-hidden="true" title="Відкрити"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000380
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

        column STATE_ICON (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ​
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="tx-ico fa #ICON_CLASS#" aria-hidden="true"></span>
            }
        )

        column ICON_CLASS (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: icon
            }
            layout {
                sequence: 30
            }
        )

        column DOC_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Номер
            }
            layout {
                sequence: 40
            }
        )

        column OCCURRED_AT (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
        )

        column ORGANIZATION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Організація
            }
            layout {
                sequence: 60
            }
        )

        column DIRECTION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Вид
            }
            layout {
                sequence: 70
            }
        )

        column COUNTERPARTY_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Контрагент
            }
            layout {
                sequence: 80
            }
        )

        column EVENT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Перша подія
            }
            layout {
                sequence: 90
            }
        )

        column BASE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Підстава
            }
            layout {
                sequence: 100
            }
        )

        column EXT_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: № постачальника
            }
            layout {
                sequence: 110
            }
        )

        column AMOUNT_WITHOUT_VAT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Без ПДВ
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column VAT_AMOUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: ПДВ
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column TOTAL_AMOUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: З ПДВ
                alignment: end
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column ERPN_STATUS_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ЄРПН
            }
            layout {
                sequence: 150
            }
        )

        column ERPN_REG_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Реєстр. №
            }
            layout {
                sequence: 160
            }
        )

        column ERPN_DEADLINE (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Зареєструвати до
            }
            layout {
                sequence: 170
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
        )

        column ERPN_OVERDUE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Прострочено
            }
            layout {
                sequence: 180
            }
        )

        column DOC_COMMENT (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Коментар
            }
            layout {
                sequence: 190
            }
        )
    )

    button create (
        buttonName: CREATE
        label: Створити
        layout {
            sequence: 10
            region: @list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 621
                clearCache: 621
            }
        }
    )
)
