    process copy (
        name: Скопіювати
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_src varchar2(32) := :P261_ID;
                begin
                  :P261_ID := trade_r3.copy_customer_order(l_src);
                  trade_series.copy_dims('DocCustomerOrder', l_src, :P261_ID);
                  trade_discount.copy_lines('DocCustomerOrder', l_src, :P261_ID);
                end;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @copy
        }
