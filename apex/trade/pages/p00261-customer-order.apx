    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @header
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000198
        }
    )

    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000199
        }
    )

    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_customer_order_goods (document_id, line_number, product_id, characteristic_id, series_id, quantity, price, manual_discount_percent, reserve_flag)
                    values (:P261_ID, null,
                            :PRODUCT_ID,
                            :CHARACTERISTIC_ID,
                            :SERIES_ID,
                            to_number(:QUANTITY, 'FM999G999G999G990D000'),
                            to_number(:PRICE, 'FM999G999G999G990D00'),
                            to_number(:MANUAL_DISCOUNT_PERCENT, 'FM990D00'),
                            :RESERVE_FLAG)
                    returning id into :ID;
                  when 'U' then
                    update doc_customer_order_goods
                       set product_id = :PRODUCT_ID,
                           characteristic_id = :CHARACTERISTIC_ID,
                           series_id = :SERIES_ID,
                           quantity = to_number(:QUANTITY, 'FM999G999G999G990D000'),
                           price = to_number(:PRICE, 'FM999G999G999G990D00'),
                           manual_discount_percent = to_number(:MANUAL_DISCOUNT_PERCENT, 'FM990D00'),
                           reserve_flag = :RESERVE_FLAG
                     where id = :ID and document_id = :P261_ID;
                  when 'D' then
                    delete from doc_customer_order_goods where id = :ID and document_id = :P261_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000200
        }
    )

    process post (
        name: Провести
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_warn.clear;
                trade_r3.post_customer_order(:P261_ID);
                :TRADE_WARN := trade_warn.take;
                ```
