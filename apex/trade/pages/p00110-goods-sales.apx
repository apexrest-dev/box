page 110 (
    name: Реалізація товарів
    alias: GOODS-SALES
    title: Реалізація товарів
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-sales
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Реалізація товарів</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region list (
        name: Реалізація товарів
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.id, case when d.status in ('POSTED', 'ISSUED') then 'fa-file-text-o tx-ico-posted' when d.status = 'CANCELLED' then 'fa-times tx-ico-marked' else 'fa-file-o tx-ico-draft' end icon_class, ' ' state_icon, (select o.name from ref_organization o where o.id = d.organization_id) organization_name, d.doc_number, d.occurred_at, c.name customer_name, w.name warehouse_name, pt.name price_type_name, d.total_amount, d.currency_code, case d.status when 'POSTED' then 'Проведено' else 'Чернетка' end status_name, d.doc_comment
                  from doc_goods_sale d
                  join ref_counterparty c on c.id = d.customer_id
                  join ref_warehouse w on w.id = d.warehouse_id
                  left join ref_price_type pt on pt.id = d.price_type_id
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 111
                clearCache: 111
                items: {
                    P111_ID: #ID#
                }
            }
            linkIcon: <span class="fa fa-file-text-o" aria-hidden="true" title="Відкрити"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000145
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

        column STATE_ICON (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ​
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="tx-ico fa #ICON_CLASS#" aria-hidden="true"></span>
            }
        )

        column ICON_CLASS (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: icon
            }
            layout {
                sequence: 30
            }
        )

        column DOC_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Номер
            }
            layout {
                sequence: 40
            }
        )

        column OCCURRED_AT (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
        )

        column ORGANIZATION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Організація
            }
            layout {
                sequence: 60
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Покупець
            }
            layout {
                sequence: 70
            }
        )

        column WAREHOUSE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Склад
            }
            layout {
                sequence: 80
            }
        )

        column PRICE_TYPE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Вид цін
            }
            layout {
                sequence: 90
            }
        )

        column TOTAL_AMOUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Всього
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column CURRENCY_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Валюта
            }
            layout {
                sequence: 110
            }
        )

        column DOC_COMMENT (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Коментар
            }
            layout {
                sequence: 120
            }
        )
    )

    button create (
        buttonName: CREATE
        label: Створити
        layout {
            sequence: 10
            region: @list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 111
                clearCache: 111
            }
        }
    )
)
