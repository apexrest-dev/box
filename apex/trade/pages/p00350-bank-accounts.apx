page 350 (
    name: Банківські рахунки
    alias: BANK-ACCOUNTS
    title: Банківські рахунки
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-cashier
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Банківські рахунки</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region list (
        name: Банківські рахунки
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case state when 'ACTIVE' then 'fa-square tx-ico-item' else 'fa-times tx-ico-marked' end icon_class, ' ' state_icon, id, code, name, organization_name, iban_display, mfo, bank_name, currency_code, case is_default when 'Y' then 'Так' end default_name, state from v_bank_account
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 351
                clearCache: 351
                items: {
                    P351_ID: #ID#
                }
            }
            linkIcon: <span class="fa fa-edit" aria-hidden="true" title="Відкрити"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000055
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

        column STATE_ICON (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ​
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="tx-ico fa #ICON_CLASS#" aria-hidden="true"></span>
            }
        )

        column ICON_CLASS (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: icon
            }
            layout {
                sequence: 30
            }
        )

        column CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Код
            }
            layout {
                sequence: 40
            }
        )

        column NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Найменування
            }
            layout {
                sequence: 50
            }
        )

        column ORGANIZATION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Організація
            }
            layout {
                sequence: 60
            }
        )

        column IBAN_DISPLAY (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: IBAN
            }
            layout {
                sequence: 70
            }
        )

        column MFO (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: МФО
            }
            layout {
                sequence: 80
            }
        )

        column BANK_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Банк
            }
            layout {
                sequence: 90
            }
        )

        column CURRENCY_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Валюта
            }
            layout {
                sequence: 100
            }
        )

        column DEFAULT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Основний
            }
            layout {
                sequence: 110
            }
        )
    )

    button create (
        buttonName: CREATE
        label: Створити
        layout {
            sequence: 10
            region: @list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 351
                clearCache: 351
            }
        }
        security {
            authorizationScheme: @role-cashier
        }
    )

    dynamicAction refresh-on-close (
        name: Оновити після закриття діалогу
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @list
        }
        execution {
            sequence: 10
        }

        action refresh (
            name: Оновити
            action: refresh
            affectedElements {
                selectionType: region
                region: @list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
