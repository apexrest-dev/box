    region lines (
        name: Товари
        title: Товари
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, document_id, line_number, product_id, characteristic_id, series_id, quantity, bin_id, trade_order_scheme.line_expected('SHIPMENT', document_id, product_id, characteristic_id, series_id) expected_qty, trade_order_scheme.bin_qty(bin_id, product_id, characteristic_id, series_id, 'N') bin_qty
                  from doc_goods_issue_order_goods
                 where document_id = :P571_ID
                 order by line_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: tx-tabpart
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P571_STATUS is not null and :P571_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                actionsMenu
            ]
            addButtonLabel: Додати рядок
        }
        advanced {
            savedReportMappingIdentifier: 910000000360
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn LINE_NUMBER (
                column: @LINE_NUMBER
                layout {
                    sequence: 10
                    show: true
                    width: 50
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 380
                }
            )

            displayColumn CHARACTERISTIC_ID (
                column: @CHARACTERISTIC_ID
                layout {
                    sequence: 30
                    show: true
                    width: 200
                }
            )

            displayColumn SERIES_ID (
                column: @SERIES_ID
                layout {
                    sequence: 40
                    show: true
                    width: 220
                }
            )

            displayColumn QUANTITY (
                column: @QUANTITY
                layout {
                    sequence: 50
                    show: true
                    width: 130
                }
            )

            displayColumn BIN_ID (
                column: @BIN_ID
                layout {
                    sequence: 60
                    show: true
                    width: 170
                }
            )

            displayColumn EXPECTED_QTY (
                column: @EXPECTED_QTY
                layout {
                    sequence: 70
                    show: true
                    width: 110
                }
            )

            displayColumn BIN_QTY (
                column: @BIN_QTY
                layout {
                    sequence: 80
                    show: true
                    width: 100
                }
            )
        )

