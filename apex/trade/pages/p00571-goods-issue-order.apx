    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @header
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000362
        }
    )

    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000363
        }
    )

    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_goods_issue_order_goods (document_id, line_number, product_id, characteristic_id, series_id, quantity, bin_id)
                    values (:P571_ID, null,
                            :PRODUCT_ID,
                            :CHARACTERISTIC_ID,
                            :SERIES_ID,
                            to_number(:QUANTITY, 'FM999G999G999G990D000'),
                            :BIN_ID)
                    returning id into :ID;
                  when 'U' then
                    update doc_goods_issue_order_goods
                       set product_id = :PRODUCT_ID,
                           characteristic_id = :CHARACTERISTIC_ID,
                           series_id = :SERIES_ID,
                           quantity = to_number(:QUANTITY, 'FM999G999G999G990D000'),
                           bin_id = :BIN_ID
                     where id = :ID and document_id = :P571_ID;
                  when 'D' then
