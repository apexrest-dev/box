page 700 (
    name: EDI: обмін з торговими мережами
    alias: EDI-EXCHANGE
    title: EDI: обмін з торговими мережами
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-sales
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>EDI: обмін з торговими мережами</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region upload (
        name: Вхідний файл (ORDERS, RECADV)
        title: Вхідний файл (ORDERS, RECADV)
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P700_FILE (
        type: fileUpload
        label {
            label: XML-файл від мережі / провайдера
            alignment: right
        }
        layout {
            sequence: 10
            region: @upload
            slot: regionBody
            columnSpan: 8
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        display {
            displayAs: inlineFileBrowse
        }
        storage {
            type: appTempFiles
            purgeFileAt: endOfRequest
            allowMultipleFiles: false
            fileTypes: .xml
        }
        help {
            helpText: Формат EDI-XML (структура EDIN / Вчасно.EDI): корінь ORDER (замовлення) або RECADV (повідомлення про приймання). Покупець, точка доставки й постачальник зіставляються за GLN, товари — за штрихкодом (упаковка — кількість × кратність), далі за кодом постачальника (артикул / код).
        }
    )

    pageItem P700_ID (
        type: hidden
        layout {
            sequence: 20
            region: @upload
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P700_STATUS (
        type: hidden
        layout {
            sequence: 21
            region: @upload
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P700_DIR (
        type: hidden
        layout {
            sequence: 22
            region: @upload
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P700_TYPE (
        type: hidden
        layout {
            sequence: 23
            region: @upload
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P700_NEW_ID (
        type: hidden
        layout {
            sequence: 24
            region: @upload
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    button load (
        buttonName: LOAD
        label: Завантажити
        layout {
            sequence: 30
            region: @upload
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-upload
        }
    )

    button sample (
        buttonName: SAMPLE_ORDERS
        label: Демо-файл ORDERS
        layout {
            sequence: 40
            region: @upload
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: false
            templateOptions: #DEFAULT#
            icon: fa-flask
        }
    )

    region message (
        name: Повідомлення
        title: Повідомлення
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return trade_edi.message_html(:P700_ID);
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P700_ID
        }
    )

    button create-order (
        buttonName: CREATE_ORDER
        label: Створити замовлення клієнта
        layout {
            sequence: 10
            region: @message
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P700_DIR = 'IN' and :P700_TYPE = 'ORDERS' and :P700_STATUS = 'NEW'
        }
    )

    button reprocess (
        buttonName: REPROCESS
        label: Повторити зіставлення
        layout {
            sequence: 20
            region: @message
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: false
            templateOptions: #DEFAULT#
            icon: fa-refresh
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P700_DIR = 'IN' and :P700_STATUS in ('NEW', 'ERROR')
        }
    )

    button send (
        buttonName: SEND
        label: Надіслати провайдеру
        layout {
            sequence: 30
            region: @message
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-paper-plane
        }
        behavior {
            requiresConfirmation: true
        }
        confirmation {
            message: Надіслати повідомлення через провайдера EDI?
            style: warning
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P700_DIR = 'OUT' and :P700_STATUS = 'GENERATED'
        }
    )

    button download (
        buttonName: DOWNLOAD
        label: Вивантажити XML
        layout {
            sequence: 40
            region: @message
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: false
            templateOptions: #DEFAULT#
            icon: fa-download
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P700_ID is not null
        }
    )

    button sample-recadv (
        buttonName: SAMPLE_RECADV
        label: Імітувати RECADV мережі
        layout {
            sequence: 50
            region: @message
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: false
            templateOptions: #DEFAULT#
            icon: fa-flask
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P700_DIR = 'OUT' and :P700_TYPE = 'DESADV' and :P700_STATUS in ('GENERATED', 'SENT')
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Скасувати
        layout {
            sequence: 60
            region: @message
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: false
            templateOptions: #DEFAULT#
            icon: fa-ban
        }
        behavior {
            requiresConfirmation: true
        }
        confirmation {
            message: Скасувати повідомлення? Скасоване не обробляється й не надсилається.
            style: warning
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P700_STATUS in ('NEW', 'ERROR', 'GENERATED')
        }
    )

    button close (
        buttonName: CLOSE
        label: Закрити
        layout {
            sequence: 70
            region: @message
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P700_ID is not null
        }
    )

    region journal (
        name: Журнал EDI-повідомлень
        title: Журнал EDI-повідомлень
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, ' ' icon, icon_class, msg_no, created_at, direction_name, msg_type, status_name, doc_number, doc_date,
                       order_number, counterparty_name, delivery_point_name, customer_order_number, sale_number, line_count,
                       error_count, diff_count, total_amount, provider_code, file_name, created_by
                  from v_edi_message
                 order by msg_no desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 700
                clearCache: 700
                items: {
                    P700_ID: #ID#
                }
            }
            linkIcon: <span class="fa fa-folder-open-o" aria-hidden="true" title="Відкрити"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000481
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

        column ICON (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ​
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="fa #ICON_CLASS#" aria-hidden="true"></span>
            }
        )

        column ICON_CLASS (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: icon
            }
            layout {
                sequence: 30
            }
        )

        column MSG_NO (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: №
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column CREATED_AT (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Створено
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI
            }
        )

        column DIRECTION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
