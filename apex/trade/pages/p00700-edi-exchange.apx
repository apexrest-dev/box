            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: № документа
            }
            layout {
                sequence: 90
            }
        )

        column DOC_DATE (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата
            }
            layout {
                sequence: 100
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
        )

        column ORDER_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: № замовлення мережі
            }
            layout {
                sequence: 110
            }
        )

        column COUNTERPARTY_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Контрагент
            }
            layout {
                sequence: 120
            }
        )

        column DELIVERY_POINT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Точка доставки
            }
            layout {
                sequence: 130
            }
        )

        column CUSTOMER_ORDER_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Замовлення клієнта
            }
            layout {
                sequence: 140
            }
        )

        column SALE_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Реалізація
            }
            layout {
                sequence: 150
            }
        )

        column LINE_COUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Рядків
                alignment: end
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
        )

        column ERROR_COUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
