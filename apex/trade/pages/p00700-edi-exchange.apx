    process init (
        name: Стан повідомлення
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P700_STATUS := null;
                :P700_DIR := null;
                :P700_TYPE := null;
                for m in (select status, direction, msg_type from sys_edi_message where id = :P700_ID) loop
                  :P700_STATUS := m.status;
                  :P700_DIR := m.direction;
                  :P700_TYPE := m.msg_type;
                end loop;
                if :P700_STATUS is null then
                  :P700_ID := null;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000482
        }
    )

    process load (
        name: Завантажити файл
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_blob blob;
                  l_name varchar2(400);
                begin
                  select max(blob_content), max(filename) into l_blob, l_name from apex_application_temp_files where name = :P700_FILE;
                  if l_blob is null then
                    trade_nsi.fail('EDI_FILE_EMPTY', 'Виберіть XML-файл для завантаження.');
                  end if;
                  :P700_ID := trade_edi.load_file(l_name, l_blob);
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('LOAD')
        }
        successMessage {
            successMessage: Файл завантажено й зіставлено з довідниками. Перевірте стан повідомлення.
        }
        advanced {
            executionMappingIdentifier: 910000000483
        }
    )

    process sample (
        name: Демо-файл ORDERS
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P700_ID := trade_edi.load_sample('ORDERS');
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('SAMPLE_ORDERS')
        }
        successMessage {
            successMessage: Завантажено демо-замовлення мережі (ORDERS).
        }
        advanced {
            executionMappingIdentifier: 910000000484
        }
    )

    process create-order (
        name: Створити замовлення клієнта
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P700_NEW_ID := trade_edi.create_order(:P700_ID);
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE_ORDER')
        }
        successMessage {
            successMessage: Створено замовлення клієнта (чернетка). Перевірте й проведіть його.
        }
        advanced {
            executionMappingIdentifier: 910000000485
        }
    )

    process reprocess (
        name: Повторити зіставлення
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_edi.reprocess(:P700_ID);
                ```
        }
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('REPROCESS')
        }
        successMessage {
            successMessage: Повідомлення зіставлено повторно.
        }
        advanced {
            executionMappingIdentifier: 910000000486
        }
    )

    process send (
        name: Надіслати
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_edi.send(:P700_ID);
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('SEND')
        }
        successMessage {
            successMessage: Повідомлення надіслано провайдеру EDI.
        }
        advanced {
            executionMappingIdentifier: 910000000487
        }
    )

    process download (
        name: Вивантажити XML
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_edi.download(:P700_ID);
                ```
        }
        execution {
            sequence: 60
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('DOWNLOAD')
        }
        advanced {
            executionMappingIdentifier: 910000000488
        }
    )

    process sample-recadv (
        name: Імітувати RECADV
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P700_ID := trade_edi.load_sample('RECADV', :P700_ID);
                ```
        }
        execution {
            sequence: 70
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('SAMPLE_RECADV')
        }
        successMessage {
            successMessage: Завантажено RECADV (імітація: нестача 1 од. першої позиції).
        }
        advanced {
            executionMappingIdentifier: 910000000489
        }
    )

    process cancel (
        name: Скасувати
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_edi.cancel(:P700_ID);
                ```
        }
        execution {
            sequence: 80
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CANCEL')
        }
        successMessage {
            successMessage: Повідомлення скасовано.
        }
        advanced {
            executionMappingIdentifier: 910000000490
        }
    )

    process close (
        name: Закрити
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P700_ID := null;
                ```
        }
        execution {
            sequence: 90
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000491
        }
    )

    branch to-order (
        name: До замовлення клієнта
        behavior {
            type: pageOrUrl
            target: {
                page: 261
                clearCache: 261
                items: {
                    P261_ID: &P700_NEW_ID.
                }
            }
        }
        execution {
            sequence: 10
            point: afterProcessing
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE_ORDER')
        }
    )

    branch stay (
        name: Залишитися
        behavior {
            type: pageOrUrl
            target: {
                page: 700
            }
        }
        execution {
            sequence: 20
            point: afterProcessing
        }
    )
)
