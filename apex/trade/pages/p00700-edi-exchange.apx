            layout {
                sequence: 180
                columnAlignment: end
            }
        )

        column TOTAL_AMOUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Сума
                alignment: end
            }
            layout {
                sequence: 190
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column PROVIDER_CODE (
            type: plainText
            source {
                dataType: varchar2
