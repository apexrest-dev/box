    process copy (
        name: Скопіювати
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_src varchar2(32) := :P111_ID;
                begin
                  :P111_ID := trade_ops.copy_goods_sale(l_src);
                  trade_series.copy_dims('DocGoodsSale', l_src, :P111_ID);
                  trade_discount.copy_lines('DocGoodsSale', l_src, :P111_ID);
                  trade_vat.copy_lines('DocGoodsSale', l_src, :P111_ID);
                end;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @copy
        }
        successMessage {
            successMessage: Створено копію документа (чернетка).
        }
        advanced {
            executionMappingIdentifier: 910000000153
        }
    )

