    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000149
        }
    )

    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_goods_sale_goods (document_id, line_number, product_id, characteristic_id, series_id, quantity, base_price, manual_discount_percent, vat_rate_code)
                    values (:P111_ID, null,
                            :PRODUCT_ID,
                            :CHARACTERISTIC_ID,
                            :SERIES_ID,
                            to_number(:QUANTITY, 'FM999G999G999G990D000'),
                            to_number(:BASE_PRICE, 'FM999G999G999G990D00'),
                            to_number(:MANUAL_DISCOUNT_PERCENT, 'FM990D00'),
                            :VAT_RATE_CODE)
                    returning id into :ID;
                  when 'U' then
                    update doc_goods_sale_goods
                       set product_id = :PRODUCT_ID,
                           characteristic_id = :CHARACTERISTIC_ID,
                           series_id = :SERIES_ID,
                           quantity = to_number(:QUANTITY, 'FM999G999G999G990D000'),
                           base_price = to_number(:BASE_PRICE, 'FM999G999G999G990D00'),
                           manual_discount_percent = to_number(:MANUAL_DISCOUNT_PERCENT, 'FM990D00'),
                           vat_rate_code = :VAT_RATE_CODE
                     where id = :ID and document_id = :P111_ID;
                  when 'D' then
                    delete from doc_goods_sale_goods where id = :ID and document_id = :P111_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000150
        }
    )

    process post (
        name: Провести
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_warn.clear;
                trade_ops.post_goods_sale(:P111_ID);
