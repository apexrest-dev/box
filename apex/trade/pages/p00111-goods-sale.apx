page 111 (
    name: Реалізація товарів
    alias: GOODS-SALE
    title: Реалізація товарів
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-sales
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>&P111_FORM_TITLE.</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Команди
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region header (
        name: Реалізація товарів
        title: Реалізація товарів
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: DOC_GOODS_SALE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P111_STATUS is not null and :P111_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    pageItem P111_ID (
        type: hidden
        layout {
            sequence: 10
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P111_DOC_NUMBER (
        type: textField
        label {
            label: Номер
            alignment: right
        }
        layout {
            sequence: 20
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @header
            column: DOC_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Порожній номер буде призначено автоматично.
        }
    )

    pageItem P111_OCCURRED_AT (
        type: datePicker
        label {
            label: Дата
            alignment: right
        }
        layout {
            sequence: 30
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: OCCURRED_AT
            dataType: date
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY HH24:MI:SS')
        }
        settings {
            displayAs: popup
            showTime: true
        }
    )

    pageItem P111_ORGANIZATION_ID (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 40
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: ORGANIZATION_ID
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trade_org.default_org
        }
        lov {
            type: sharedComponent
            lov: @organizations-active
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Від імені якої організації оформлено документ. Документ на підставі отримує організацію підстави.
        }
    )

    pageItem P111_WAREHOUSE_ID (
        type: popupLov
        label {
            label: Склад
            alignment: right
        }
        layout {
            sequence: 50
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: WAREHOUSE_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @warehouses-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
    )

    pageItem P111_CUSTOMER_ID (
        type: popupLov
        label {
            label: Покупець
            alignment: right
        }
        layout {
            sequence: 60
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: CUSTOMER_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @counterparties-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
    )

    pageItem P111_CONTRACT_ID (
        type: popupLov
        label {
            label: Договір
            alignment: right
        }
        layout {
            sequence: 70
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CONTRACT_ID
            dataType: varchar2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.name || case when c.contract_number is not null then ' № ' || c.contract_number end d, c.id r
                  from ref_contract c
                 where c.state = 'ACTIVE' and c.contract_kind = 'WITH_CUSTOMER'
                   and c.owner_id = :P111_CUSTOMER_ID
                 order by c.name
                ```
            displayExtraValues: true
            displayNullValue: true
        }
        cascadingLov {
            parentItems: [
                P111_CUSTOMER_ID
            ]
            parentRequired: false
        }
        help {
            helpText: Список договорів обраного контрагента. Якщо договір один — підставляється автоматично.
        }
    )

    pageItem P111_BASE_ORDER_ID (
        type: displayOnly
        label {
            label: Замовлення-підстава
            alignment: right
        }
        layout {
            sequence: 80
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: BASE_ORDER_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @recorders
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P111_PRICE_TYPE_ID (
        type: popupLov
        label {
            label: Вид цін
            alignment: right
        }
        layout {
            sequence: 90
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: PRICE_TYPE_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @price-types-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
        help {
            helpText: Порожня ціна в рядку заповнюється з регістру «Ціни номенклатури» за цим видом цін на дату документа.
        }
    )

    pageItem P111_CURRENCY_CODE (
        type: displayOnly
        label {
            label: Валюта
            alignment: right
        }
        layout {
            sequence: 100
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CURRENCY_CODE
            dataType: varchar2
        }
    )

    pageItem P111_PRICE_INCLUDES_VAT (
        type: selectList
        label {
            label: Ціни
            alignment: right
        }
        layout {
            sequence: 110
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: PRICE_INCLUDES_VAT
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @vat-price-modes
            displayExtraValues: true
            displayNullValue: true
        }
        help {
            helpText: Ціна включає ПДВ або ПДВ зверху. Порожньо — за видом цін (інакше «включає»). Зміна перераховує ПДВ рядків.
        }
    )

    pageItem P111_STATUS (
        type: hidden
        layout {
            sequence: 120
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: STATUS
            dataType: varchar2
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P111_FORM_TITLE (
        type: hidden
        layout {
            sequence: 130
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P111_NEW_ID (
        type: hidden
        layout {
            sequence: 140
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    region scan (
        name: Сканер
        type: staticContent
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P111_ID is not null and :P111_STATUS = 'DRAFT'
        }
    )

    pageItem P111_SCAN (
        type: textField
        label {
            label: Штрихкод / артикул
            alignment: right
        }
        layout {
            sequence: 10
            region: @scan
            slot: regionBody
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            valuePlaceholder: Відскануйте або введіть і натисніть «Додати»
        }
        advanced {
            customAttributes: autocomplete="off"
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    button scan (
        buttonName: SCAN
        label: Додати
        layout {
            sequence: 20
            region: @scan
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
    )

    button pick (
        buttonName: PICK
        label: Підбір
        layout {
            sequence: 30
            region: @scan
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 950
                clearCache: 950
                items: {
                    P950_KIND: SALE
                    P950_ID: &P111_ID.
                    P950_WH: &P111_WAREHOUSE_ID.
                    P950_PT: &P111_PRICE_TYPE_ID.
                }
            }
        }
    )

    dynamicAction after-pick (
        name: Після підбору
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pick
        }
        execution {
            sequence: 10
        }

        action reload (
            name: Перезавантажити
            action: submitPage
            settings {
                requestButtonName: PICKED
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    region lines (
        name: Товари
        title: Товари
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, document_id, line_number, product_id, characteristic_id, series_id, quantity, base_price, manual_discount_percent, auto_discount_percent, trade_discount.rule_label(discount_id) discount_name, discount_percent, price, amount, vat_rate_code, vat_amount, amount_with_vat
                  from doc_goods_sale_goods
                 where document_id = :P111_ID
                 order by line_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: tx-tabpart
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P111_STATUS is not null and :P111_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                actionsMenu
            ]
            addButtonLabel: Додати рядок
        }
        advanced {
            savedReportMappingIdentifier: 910000000146
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn LINE_NUMBER (
                column: @LINE_NUMBER
                layout {
                    sequence: 10
                    show: true
                    width: 50
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 380
                }
            )

            displayColumn CHARACTERISTIC_ID (
                column: @CHARACTERISTIC_ID
                layout {
                    sequence: 30
                    show: true
                    width: 200
                }
            )

            displayColumn SERIES_ID (
                column: @SERIES_ID
                layout {
                    sequence: 40
                    show: true
                    width: 220
                }
            )

            displayColumn QUANTITY (
                column: @QUANTITY
                layout {
                    sequence: 50
                    show: true
                    width: 130
                }
            )

            displayColumn BASE_PRICE (
                column: @BASE_PRICE
                layout {
                    sequence: 60
                    show: true
                    width: 130
                }
            )

            displayColumn MANUAL_DISCOUNT_PERCENT (
                column: @MANUAL_DISCOUNT_PERCENT
                layout {
                    sequence: 70
                    show: true
                    width: 100
                }
            )

            displayColumn AUTO_DISCOUNT_PERCENT (
                column: @AUTO_DISCOUNT_PERCENT
                layout {
                    sequence: 80
                    show: true
                    width: 90
                }
            )

            displayColumn DISCOUNT_NAME (
                column: @DISCOUNT_NAME
                layout {
                    sequence: 90
                    show: true
                    width: 200
                }
            )

            displayColumn DISCOUNT_PERCENT (
                column: @DISCOUNT_PERCENT
                layout {
                    sequence: 100
                    show: true
                    width: 80
                }
            )

            displayColumn PRICE (
                column: @PRICE
                layout {
                    sequence: 110
                    show: true
                    width: 110
                }
            )

            displayColumn AMOUNT (
                column: @AMOUNT
                layout {
                    sequence: 120
                    show: true
                    width: 140
                }
            )

            displayColumn VAT_RATE_CODE (
                column: @VAT_RATE_CODE
                layout {
                    sequence: 130
                    show: true
                    width: 130
                }
            )

            displayColumn VAT_AMOUNT (
                column: @VAT_AMOUNT
                layout {
                    sequence: 140
                    show: true
                    width: 110
                }
            )

            displayColumn AMOUNT_WITH_VAT (
                column: @AMOUNT_WITH_VAT
                layout {
                    sequence: 150
                    show: true
                    width: 120
                }
            )
        )

        column ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: ID
                dataType: varchar2
                primaryKey: true
            }
            layout {
                sequence: 10
            }
        )

        column DOCUMENT_ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: DOCUMENT_ID
                dataType: varchar2
            }
            layout {
                sequence: 20
            }
        )

        column LINE_NUMBER (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: LINE_NUMBER
                dataType: number
            }
            heading {
                heading: N
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column PRODUCT_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: PRODUCT_ID
                dataType: varchar2
            }
            heading {
                heading: Товар
                alignment: start
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @products-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
        )

        column CHARACTERISTIC_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: CHARACTERISTIC_ID
                dataType: varchar2
            }
            heading {
                heading: Характеристика
                alignment: start
            }
            layout {
                sequence: 50
            }
            lov {
                type: sharedComponent
                lov: @product-characteristics-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
            help {
                helpText: Для товарів з ознакою «Використовувати характеристики» (розмір, колір …) — обов'язкова при проведенні.
            }
        )

        column SERIES_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: SERIES_ID
                dataType: varchar2
            }
            heading {
                heading: Серія
                alignment: start
            }
            layout {
                sequence: 60
            }
            lov {
                type: sharedComponent
                lov: @product-series-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
            help {
                helpText: Для товарів з обліком серій. У видаткових документах порожня серія підбирається за FEFO під час проведення.
            }
        )

        column QUANTITY (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: QUANTITY
                dataType: number
            }
            heading {
                heading: Кількість
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column BASE_PRICE (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: BASE_PRICE
                dataType: number
            }
            heading {
                heading: Ціна
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            help {
                helpText: Ціна до знижки. Залиште порожньою — ціна підставиться з виду цін.
            }
        )

        column MANUAL_DISCOUNT_PERCENT (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: MANUAL_DISCOUNT_PERCENT
                dataType: number
            }
            heading {
                heading: Ручна знижка, %
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM990D00
            }
            help {
                helpText: Обмежена максимальною ручною знижкою вашої ролі (регістр «Обмеження ручних знижок»).
            }
        )

        column AUTO_DISCOUNT_PERCENT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: AUTO_DISCOUNT_PERCENT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Авт. знижка, %
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: FM990D00
            }
        )

        column DISCOUNT_NAME (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: DISCOUNT_NAME
                dataType: varchar2
                queryOnly: true
            }
            heading {
                heading: Умова знижки
                alignment: start
            }
            layout {
                sequence: 110
            }
        )

        column DISCOUNT_PERCENT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: DISCOUNT_PERCENT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Знижка, %
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: FM990D00
            }
        )

        column PRICE (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: PRICE
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Ціна зі знижкою
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Сума
                alignment: end
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column VAT_RATE_CODE (
            type: selectList
            source {
                type: databaseColumn
                databaseColumn: VAT_RATE_CODE
                dataType: varchar2
            }
            heading {
                heading: Ставка ПДВ
                alignment: start
            }
            layout {
                sequence: 150
            }
            lov {
                type: sharedComponent
                lov: @vat-rates
                displayExtraValues: true
                displayNullValue: true
            }
            help {
                helpText: Порожньо — ставка товару (організація / постачальник не платник — «Без ПДВ»).
            }
        )

        column VAT_AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: VAT_AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Сума ПДВ
                alignment: end
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column AMOUNT_WITH_VAT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: AMOUNT_WITH_VAT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Всього
                alignment: end
            }
            layout {
                sequence: 170
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
