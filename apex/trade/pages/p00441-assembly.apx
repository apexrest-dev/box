page 441 (
    name: Комплектація товарів
    alias: ASSEMBLY
    title: Комплектація товарів
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-warehouse
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>&P441_FORM_TITLE.</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Команди
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region header (
        name: Комплектація товарів
        title: Комплектація товарів
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: DOC_ASSEMBLY
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P441_STATUS is not null and :P441_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    pageItem P441_ID (
        type: hidden
        layout {
            sequence: 10
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P441_DOC_NUMBER (
        type: textField
        label {
            label: Номер
            alignment: right
        }
        layout {
            sequence: 20
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @header
            column: DOC_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Порожній номер буде призначено автоматично.
        }
    )

    pageItem P441_OCCURRED_AT (
        type: datePicker
        label {
            label: Дата
            alignment: right
        }
        layout {
            sequence: 30
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: OCCURRED_AT
            dataType: date
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY HH24:MI:SS')
        }
        settings {
            displayAs: popup
            showTime: true
        }
    )

    pageItem P441_ORGANIZATION_ID (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 40
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: ORGANIZATION_ID
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trade_org.default_org
        }
        lov {
            type: sharedComponent
            lov: @organizations-active
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Від імені якої організації оформлено документ. Документ на підставі отримує організацію підстави.
        }
    )

    pageItem P441_OPERATION_KIND (
        type: selectList
        label {
            label: Вид операції
            alignment: right
        }
        layout {
            sequence: 50
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: OPERATION_KIND
            dataType: varchar2
        }
        default {
            type: static
            staticValue: ASSEMBLY
        }
        lov {
            type: sharedComponent
            lov: @assembly-operation-kinds
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Комплектація: списує комплектуючі й оприбутковує набір за сумою їх собівартості. Розкомплектація: списує набір і оприбутковує комплектуючі.
        }
    )

    pageItem P441_WAREHOUSE_ID (
        type: popupLov
        label {
            label: Склад
            alignment: right
        }
        layout {
            sequence: 60
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: WAREHOUSE_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @warehouses-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
    )

    pageItem P441_KIT_PRODUCT_ID (
        type: popupLov
        label {
            label: Набір
            alignment: right
        }
        layout {
            sequence: 70
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: KIT_PRODUCT_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @products-goods
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
    )

    pageItem P441_BOM_ID (
        type: popupLov
        label {
            label: Специфікація
            alignment: right
        }
        layout {
            sequence: 80
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: BOM_ID
            dataType: varchar2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select code || ' ' || name || case is_main when 'Y' then ' (основна)' end d, id r
                  from ref_bill_of_materials
                 where state = 'ACTIVE' and product_id = :P441_KIT_PRODUCT_ID
                 order by case is_main when 'Y' then 0 else 1 end, code
                ```
            displayExtraValues: true
            displayNullValue: true
        }
        cascadingLov {
            parentItems: [
                P441_KIT_PRODUCT_ID
            ]
            parentRequired: false
        }
        help {
            helpText: Порожнє — основна специфікація набору (підставляється під час запису).
        }
    )

    pageItem P441_QUANTITY (
        type: numberField
        label {
            label: Кількість наборів
            alignment: right
        }
        layout {
            sequence: 90
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D000
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: QUANTITY
            dataType: number
        }
        default {
            type: static
            staticValue: 1
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
        }
    )

    pageItem P441_KIT_COST_AMOUNT (
        type: displayOnly
        label {
            label: Собівартість наборів
            alignment: right
        }
        layout {
            sequence: 100
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: KIT_COST_AMOUNT
            dataType: number
            queryOnly: true
        }
        help {
            helpText: Розраховується під час проведення (сума собівартості комплектуючих).
        }
    )

    pageItem P441_STATUS (
        type: hidden
        layout {
            sequence: 110
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: STATUS
            dataType: varchar2
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P441_FORM_TITLE (
        type: hidden
        layout {
            sequence: 120
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P441_NEW_ID (
        type: hidden
        layout {
            sequence: 130
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    region lines (
        name: Комплектуючі
        title: Комплектуючі
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, document_id, line_number, product_id, characteristic_id, series_id, quantity, trade_assembly.line_free_qty(document_id, product_id) free_qty, cost_amount
                  from doc_assembly_goods
                 where document_id = :P441_ID
                 order by line_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: tx-tabpart
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P441_STATUS is not null and :P441_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                actionsMenu
            ]
            addButtonLabel: Додати рядок
        }
        advanced {
            savedReportMappingIdentifier: 910000000343
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn LINE_NUMBER (
                column: @LINE_NUMBER
                layout {
                    sequence: 10
                    show: true
                    width: 50
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 380
                }
            )

            displayColumn CHARACTERISTIC_ID (
                column: @CHARACTERISTIC_ID
                layout {
                    sequence: 30
                    show: true
                    width: 200
                }
            )

            displayColumn SERIES_ID (
                column: @SERIES_ID
                layout {
                    sequence: 40
                    show: true
                    width: 220
                }
            )

            displayColumn QUANTITY (
                column: @QUANTITY
                layout {
                    sequence: 50
                    show: true
                    width: 130
                }
            )

            displayColumn FREE_QTY (
                column: @FREE_QTY
                layout {
                    sequence: 60
                    show: true
                    width: 130
                }
            )

            displayColumn COST_AMOUNT (
                column: @COST_AMOUNT
                layout {
                    sequence: 70
                    show: true
                    width: 130
                }
            )
        )

        column ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: ID
                dataType: varchar2
                primaryKey: true
            }
            layout {
                sequence: 10
            }
        )

        column DOCUMENT_ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: DOCUMENT_ID
                dataType: varchar2
            }
            layout {
                sequence: 20
            }
        )

        column LINE_NUMBER (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: LINE_NUMBER
                dataType: number
            }
            heading {
                heading: N
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column PRODUCT_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: PRODUCT_ID
                dataType: varchar2
            }
            heading {
                heading: Товар
                alignment: start
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @products-goods
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
        )

        column CHARACTERISTIC_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: CHARACTERISTIC_ID
                dataType: varchar2
            }
            heading {
                heading: Характеристика
                alignment: start
            }
            layout {
                sequence: 50
            }
            lov {
                type: sharedComponent
                lov: @product-characteristics-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
            help {
                helpText: Для товарів з ознакою «Використовувати характеристики» (розмір, колір …) — обов'язкова при проведенні.
            }
        )

        column SERIES_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: SERIES_ID
                dataType: varchar2
            }
            heading {
                heading: Серія
                alignment: start
            }
            layout {
                sequence: 60
            }
            lov {
                type: sharedComponent
                lov: @product-series-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
            help {
                helpText: Для товарів з обліком серій. У видаткових документах порожня серія підбирається за FEFO під час проведення.
            }
        )

        column QUANTITY (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: QUANTITY
                dataType: number
            }
            heading {
                heading: Кількість
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column FREE_QTY (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: FREE_QTY
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Вільний залишок
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column COST_AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: COST_AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Собівартість
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )
    )

    region footer (
        name: Підвал
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P441_DOC_COMMENT (
        type: textarea
        label {
            label: Коментар
            alignment: right
        }
        layout {
            sequence: 140
            region: @footer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @header
            column: DOC_COMMENT
            dataType: varchar2
        }
        settings {
            resizable: true
            autoHeight: false
            charCounter: true
            trimSpaces: leadingAndTrailing
        }
    )

    process form-title (
        name: Заголовок форми
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P441_FORM_TITLE := trade_ui.doc_title('Комплектація товарів', :P441_DOC_NUMBER, :P441_OCCURRED_AT, :P441_STATUS);
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000344
        }
    )

    button create-post-close (
        buttonName: CREATE_POST_CLOSE
        label: Провести і закрити
        layout {
            sequence: 10
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P441_ID
        }
    )

    button post-close (
        buttonName: POST_CLOSE
        label: Провести і закрити
        layout {
            sequence: 11
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P441_ID is not null and :P441_STATUS = 'DRAFT'
        }
    )

    button create (
        buttonName: CREATE
        label: Записати
        layout {
            sequence: 20
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P441_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Записати
        layout {
            sequence: 21
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P441_ID is not null and :P441_STATUS = 'DRAFT'
        }
    )

    button create-post (
        buttonName: CREATE_POST
        label: Провести
        layout {
            sequence: 30
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P441_ID
        }
    )

    button post (
        buttonName: POST
        label: Провести
        layout {
            sequence: 31
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P441_ID is not null and :P441_STATUS = 'DRAFT'
        }
    )

    button unpost (
        buttonName: UNPOST
        label: Скасувати проведення
        layout {
            sequence: 40
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Скасувати проведення документа? Рухи регістрів буде видалено.
            style: warning
        }
        serverSideCondition {
            type: item=value
            item: P441_STATUS
            value: POSTED
        }
    )

    button cmd-fill-by-bom (
        buttonName: FILL_BY_BOM
        label: Заповнити за специфікацією
        layout {
            sequence: 41
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Замінити комплектуючі рядками специфікації (за записаними набором, специфікацією й кількістю)?
            style: warning
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P441_ID is not null and :P441_STATUS = 'DRAFT'
        }
    )

    button cmd-fill-series (
        buttonName: FILL_SERIES
        label: Підібрати серії (FEFO)
        layout {
            sequence: 42
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P441_ID is not null and :P441_STATUS = 'DRAFT'
        }
    )

    button cmd-create-receipt-order (
        buttonName: CREATE_RECEIPT_ORDER
        label: Створити прибутковий ордер
        layout {
            sequence: 43
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: item=value
            item: P441_STATUS
            value: POSTED
        }
        security {
            authorizationScheme: @role-warehouse
        }
    )

    button cmd-create-issue-order (
        buttonName: CREATE_ISSUE_ORDER
        label: Створити видатковий ордер
        layout {
            sequence: 44
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: item=value
            item: P441_STATUS
            value: POSTED
        }
        security {
            authorizationScheme: @role-warehouse
        }
    )

    button cmd-print (
        buttonName: PRINT
        label: Друк
        layout {
            sequence: 45
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P441_ID
        }
    )

    button copy (
        buttonName: COPY
        label: Скопіювати (F9)
        layout {
            sequence: 50
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P441_ID
