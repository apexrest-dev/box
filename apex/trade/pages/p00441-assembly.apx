    process copy (
        name: Скопіювати
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_src varchar2(32) := :P441_ID;
                begin
                  :P441_ID := trade_assembly.copy(l_src);
                  trade_series.copy_dims('DocAssembly', l_src, :P441_ID);
                end;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
