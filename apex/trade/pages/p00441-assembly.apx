    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000346
        }
    )

    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_assembly_goods (document_id, line_number, product_id, characteristic_id, series_id, quantity)
                    values (:P441_ID, null,
                            :PRODUCT_ID,
                            :CHARACTERISTIC_ID,
                            :SERIES_ID,
                            to_number(:QUANTITY, 'FM999G999G999G990D000'))
                    returning id into :ID;
                  when 'U' then
                    update doc_assembly_goods
                       set product_id = :PRODUCT_ID,
                           characteristic_id = :CHARACTERISTIC_ID,
                           series_id = :SERIES_ID,
                           quantity = to_number(:QUANTITY, 'FM999G999G999G990D000')
                     where id = :ID and document_id = :P441_ID;
                  when 'D' then
                    delete from doc_assembly_goods where id = :ID and document_id = :P441_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000347
        }
    )

    process post (
        name: Провести
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_warn.clear;
                trade_assembly.post(:P441_ID);
                :TRADE_WARN := trade_warn.take;
                ```
