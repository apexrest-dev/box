page 360 (
    name: Залишки й обороти коштів
    alias: CASH-BALANCE
    title: Залишки й обороти коштів
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-cashier
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Залишки й обороти коштів</h1></div>
        }
        layout {
            sequence: 0
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region filter (
        name: Відбір
        type: staticContent
        layout {
            sequence: 3
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P360_ORG (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @organizations-all
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: Усі організації
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    button apply-org (
        buttonName: APPLY_ORG
        label: Застосувати
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    region mode (
        name: Режим
        type: regionDisplaySelector
        layout {
            sequence: 5
            slot: body
        }
        settings {
            mode: viewSingleRegion
            includeShowAll: false
            rememberSelection: bySession
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region balances (
        name: Залишки
        title: Залишки
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select organization_name, place_kind_name, place_code, place_name, currency_code, balance, rate, rate_date, balance_uah
                  from v_cash_balance_uah
                 where (:P360_ORG is null or organization_id = :P360_ORG)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            regionDisplaySelector: true
            savedReportMappingIdentifier: 910000000426
        }


        column ORGANIZATION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Організація
            }
            layout {
                sequence: 10
            }
        )

        column PLACE_KIND_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Вид
            }
            layout {
                sequence: 20
            }
        )

        column PLACE_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Код
            }
            layout {
                sequence: 30
            }
        )

        column PLACE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Каса / рахунок
            }
            layout {
                sequence: 40
            }
        )

        column CURRENCY_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Валюта
            }
            layout {
                sequence: 50
            }
        )

        column BALANCE (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Залишок
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column RATE (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Курс НБУ
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: FM999G990D0000
            }
        )

        column RATE_DATE (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата курсу
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
        )

        column BALANCE_UAH (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Еквівалент, грн
            }
            layout {
                sequence: 90
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )
    )

    region turnovers (
        name: Обороти
        title: Обороти
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P360_FROM (
        type: datePicker
        label {
            label: Початок періоду
            alignment: right
        }
        layout {
            sequence: 10
            region: @turnovers
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(trunc(sysdate, 'MM'), 'DD.MM.YYYY')
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P360_TO (
        type: datePicker
        label {
            label: Кінець періоду
            alignment: right
        }
        layout {
            sequence: 20
            region: @turnovers
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(trunc(sysdate), 'DD.MM.YYYY')
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    button apply (
        buttonName: APPLY
        label: Сформувати
        layout {
            sequence: 30
            region: @turnovers
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    region turnover-report (
        name: Обороти за період
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            pageItemsToSubmit: [
                P360_FROM
                P360_TO
                P360_ORG
            ]
            sqlQuery:
                ```sql
                select x.*, trade_currency.rate(x.currency_code, to_date(:P360_TO, 'DD.MM.YYYY') + 1 - 1) closing_rate,
                       trade_currency.to_uah(x.closing, x.currency_code, to_date(:P360_TO, 'DD.MM.YYYY') + 1 - 1) closing_uah
                  from (select m.organization_name, m.place_kind_name, m.place_name, m.currency_code,
                       sum(case when m.period < to_date(:P360_FROM, 'DD.MM.YYYY') then m.amount else 0 end) opening,
                       sum(case when m.period >= to_date(:P360_FROM, 'DD.MM.YYYY') and m.period < to_date(:P360_TO, 'DD.MM.YYYY') + 1 then m.incoming else 0 end) incoming,
                       sum(case when m.period >= to_date(:P360_FROM, 'DD.MM.YYYY') and m.period < to_date(:P360_TO, 'DD.MM.YYYY') + 1 then m.outgoing else 0 end) outgoing,
                       sum(case when m.period < to_date(:P360_TO, 'DD.MM.YYYY') + 1 then m.amount else 0 end) closing
                  from v_cash_movement m
                 where (:P360_ORG is null or m.organization_id = :P360_ORG)
                 group by m.organization_name, m.place_kind_name, m.place_name, m.currency_code) x
                ```
        }
        layout {
            sequence: 30
            parentRegion: @turnovers
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000427
        }


        column ORGANIZATION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Організація
            }
            layout {
                sequence: 10
            }
        )

        column PLACE_KIND_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Вид
            }
            layout {
                sequence: 20
            }
        )

        column PLACE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Каса / рахунок
            }
            layout {
