        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P360_OB_PLACE (
        type: selectList
        label {
            label: Каса / рахунок
            alignment: right
        }
        layout {
            sequence: 10
            region: @opening
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @cash-places-active
            displayExtraValues: false
            displayNullValue: true
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P360_OB_DATE (
        type: datePicker
        label {
            label: Дата залишку
            alignment: right
        }
        layout {
            sequence: 20
            region: @opening
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(trunc(sysdate, 'MM'), 'DD.MM.YYYY')
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P360_OB_AMOUNT (
        type: numberField
        label {
            label: Сума
            alignment: right
        }
        layout {
            sequence: 30
            region: @opening
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
        }
        help {
            helpText: Залишок у валюті каси / рахунку на початок дати. Повторне введення замінює попереднє; 0 — видаляє введення. Зменшення залишку перевіряється: витрати після дати не можуть зробити залишок від'ємним.
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    button set-opening (
        buttonName: SET_OPENING
        label: Записати залишок
        layout {
            sequence: 40
            region: @opening
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @role-cashier
        }
    )

    process set-opening (
        name: Записати початковий залишок
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_kind varchar2(12);
                begin
                  select max(place_kind) into l_kind from v_cash_place where place_id = :P360_OB_PLACE;
                  trade_cash.set_opening_balance(l_kind, :P360_OB_PLACE, to_date(:P360_OB_DATE, 'DD.MM.YYYY'),
                                                 to_number(replace(translate(:P360_OB_AMOUNT, 'x ' || unistr('\00A0'), 'x'), ',', '.'), '999999999999990.99'));
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @set-opening
        }
        successMessage {
            successMessage: Початковий залишок записано.
        }
        advanced {
            executionMappingIdentifier: 910000000424
        }
    )

    region opening-list (
        name: Введені залишки
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.organization_name, m.place_kind_name, m.place_name, m.currency_code, m.period, m.amount
                  from v_cash_movement m
                 where m.recorder_type = 'CashOpeningBalance' and (:P360_ORG is null or m.organization_id = :P360_ORG)
                ```
        }
        layout {
            sequence: 50
            parentRegion: @opening
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000425
        }


        column ORGANIZATION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Організація
            }
            layout {
                sequence: 10
            }
        )

        column PLACE_KIND_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Вид
            }
            layout {
                sequence: 20
            }
        )

        column PLACE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Каса / рахунок
            }
            layout {
                sequence: 30
            }
        )

        column CURRENCY_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Валюта
            }
            layout {
                sequence: 40
            }
        )

        column PERIOD (
            type: plainText
