                dataType: date
            }
            heading {
                heading: Дата
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
        )

        column AMOUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Сума
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )
    )
)
