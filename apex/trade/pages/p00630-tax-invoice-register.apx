page 630 (
    name: Реєстр податкових накладних
    alias: TAX-INVOICE-REGISTER
    title: Реєстр податкових накладних
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-tax
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Реєстр податкових накладних</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region bar (
        name: Відбір
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P630_FROM (
        type: datePicker
        label {
            label: З
            alignment: right
        }
        layout {
            sequence: 10
            region: @bar
            slot: regionBody
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(trunc(sysdate, 'MM'), 'DD.MM.YYYY')
        }
        settings {
            displayAs: popup
            showTime: false
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P630_TO (
        type: datePicker
        label {
            label: По
            alignment: right
        }
        layout {
            sequence: 11
            region: @bar
            slot: regionBody
            columnSpan: 2
            startNewRow: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY')
        }
        settings {
            displayAs: popup
            showTime: false
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    pageItem P630_ORG (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 20
            region: @bar
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @organizations-all
            displayExtraValues: false
            displayNullValue: true
            nullDisplayValue: Усі організації
        }
        sessionState {
            dataType: varchar2
            storage: session
        }
    )

    button apply (
        buttonName: APPLY
        label: Сформувати
        layout {
            sequence: 40
            region: @bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    button generate (
        buttonName: GENERATE
        label: Створити ПН за першою подією
        layout {
            sequence: 50
            region: @bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            requiresConfirmation: true
        }
        confirmation {
            message: Створити й провести податкові накладні за всіма подіями періоду без ПН?
            style: warning
        }
    )

    process generate (
        name: Створити ПН за першою подією
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                declare
                  l_n number;
                begin
                  l_n := trade_tax.generate(coalesce(to_date(:P630_FROM, 'DD.MM.YYYY'), trunc(sysdate, 'MM')), coalesce(to_date(:P630_TO, 'DD.MM.YYYY'), trunc(sysdate)), :P630_ORG, 'Y');
                  apex_application.g_print_success_message := 'Створено й проведено податкових накладних: ' || l_n || '.';
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @generate
        }
        advanced {
            executionMappingIdentifier: 910000000449
        }
    )

    region summary (
        name: Зведення ПДВ
        title: Зведення ПДВ за період
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return trade_tax.register_html(coalesce(to_date(:P630_FROM, 'DD.MM.YYYY'), trunc(sysdate, 'MM')), coalesce(to_date(:P630_TO, 'DD.MM.YYYY'), trunc(sysdate)), :P630_ORG);
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region invoices (
        name: Податкові накладні періоду
        title: Податкові накладні періоду
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            pageItemsToSubmit: [
                P630_FROM
                P630_TO
                P630_ORG
            ]
            sqlQuery:
                ```sql
                select d.id, d.occurred_at, d.doc_number, d.organization_name, d.direction_name, d.counterparty_name,
                       case when d.direction = 'ISSUED' then d.buyer_vat_number else d.seller_vat_number end vat_number,
                       d.event_name, d.base_name, d.ext_number, d.amount_without_vat, d.vat_amount, d.total_amount, d.status_name,
                       d.erpn_status_name, d.erpn_reg_number, d.erpn_deadline, d.erpn_overdue,
                       apex_page.get_url(p_page => 621, p_items => 'P621_ID', p_values => d.id) doc_url
                  from v_tax_invoice_list d
                 where d.occurred_at >= coalesce(to_date(:P630_FROM, 'DD.MM.YYYY'), trunc(sysdate, 'MM')) and d.occurred_at < coalesce(to_date(:P630_TO, 'DD.MM.YYYY'), trunc(sysdate)) + 1
                   and (:P630_ORG is null or d.organization_id = :P630_ORG)
                 order by d.direction, d.occurred_at, d.doc_number
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000450
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

