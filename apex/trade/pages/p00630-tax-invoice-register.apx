    region open-events (
        name: Події без податкової накладної
        title: Події без податкової накладної
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            pageItemsToSubmit: [
                P630_FROM
                P630_TO
                P630_ORG
            ]
            sqlQuery:
                ```sql
                select e.event_date, e.doc_id, r.recorder_name doc_name, o.name organization_name, c.name counterparty_name,
                       case e.event_kind when 'SHIPMENT' then 'Відвантаження' else 'Оплата' end event_name,
                       e.event_amount, e.base_amount, e.invoiced_amount, e.remaining_amount,
                       apex_page.get_url(p_page => r.page_id, p_items => 'P' || r.page_id || '_ID', p_values => e.doc_id) doc_url
                  from table(trade_tax.events(coalesce(to_date(:P630_FROM, 'DD.MM.YYYY'), trunc(sysdate, 'MM')), coalesce(to_date(:P630_TO, 'DD.MM.YYYY'), trunc(sysdate)), :P630_ORG)) e
                  join ref_organization o on o.id = e.organization_id
                  join ref_counterparty c on c.id = e.counterparty_id
                  left join v_recorder r on r.recorder_type = e.doc_type and r.recorder_id = e.doc_id
                 where e.remaining_amount > 0
                 order by e.event_date
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: exclude
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000451
        }


        column EVENT_DATE (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата
            }
            layout {
                sequence: 10
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI
            }
        )

