page 271 (
    name: Замовлення постачальнику
    alias: SUPPLIER-ORDER
    title: Замовлення постачальнику
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-purchase
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>&P271_FORM_TITLE.</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Команди
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region header (
        name: Замовлення постачальнику
        title: Замовлення постачальнику
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: DOC_SUPPLIER_ORDER
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P271_STATUS is not null and :P271_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    pageItem P271_ID (
        type: hidden
        layout {
            sequence: 10
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P271_DOC_NUMBER (
        type: textField
        label {
            label: Номер
            alignment: right
        }
        layout {
            sequence: 20
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @header
            column: DOC_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Порожній номер буде призначено автоматично.
        }
    )

    pageItem P271_OCCURRED_AT (
        type: datePicker
        label {
            label: Дата
            alignment: right
        }
        layout {
            sequence: 30
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: OCCURRED_AT
            dataType: date
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY HH24:MI:SS')
        }
        settings {
            displayAs: popup
            showTime: true
        }
    )

    pageItem P271_ORGANIZATION_ID (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 40
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: ORGANIZATION_ID
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trade_org.default_org
        }
        lov {
            type: sharedComponent
            lov: @organizations-active
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Від імені якої організації оформлено документ. Документ на підставі отримує організацію підстави.
        }
    )

    pageItem P271_SUPPLIER_ID (
        type: popupLov
        label {
            label: Постачальник
            alignment: right
        }
        layout {
            sequence: 50
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: SUPPLIER_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @counterparties-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
    )

    pageItem P271_CONTRACT_ID (
        type: popupLov
        label {
            label: Договір
            alignment: right
        }
        layout {
            sequence: 60
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CONTRACT_ID
            dataType: varchar2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.name || case when c.contract_number is not null then ' № ' || c.contract_number end d, c.id r
                  from ref_contract c
                 where c.state = 'ACTIVE' and c.contract_kind = 'WITH_SUPPLIER'
                   and c.owner_id = :P271_SUPPLIER_ID
                 order by c.name
                ```
            displayExtraValues: true
            displayNullValue: true
        }
        cascadingLov {
            parentItems: [
                P271_SUPPLIER_ID
            ]
            parentRequired: false
        }
        help {
            helpText: Список договорів обраного контрагента. Якщо договір один — підставляється автоматично.
        }
    )

    pageItem P271_WAREHOUSE_ID (
        type: popupLov
        label {
            label: Склад
            alignment: right
        }
        layout {
            sequence: 70
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: WAREHOUSE_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @warehouses-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
    )

    pageItem P271_EXPECTED_DATE (
        type: datePicker
        label {
            label: Очікується
            alignment: right
        }
        layout {
            sequence: 80
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY
        }
        source {
            formRegion: @header
            column: EXPECTED_DATE
            dataType: date
        }
        settings {
            displayAs: popup
            showTime: false
        }
    )

    pageItem P271_CLOSED (
        type: hidden
        layout {
            sequence: 90
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: CLOSED
            dataType: varchar2
        }
    )

    pageItem P271_STATUS (
        type: hidden
        layout {
            sequence: 100
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: STATUS
            dataType: varchar2
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P271_FORM_TITLE (
        type: hidden
        layout {
            sequence: 110
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P271_NEW_ID (
        type: hidden
        layout {
            sequence: 120
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    region scan (
        name: Сканер
        type: staticContent
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P271_ID is not null and :P271_STATUS = 'DRAFT'
        }
    )

    pageItem P271_SCAN (
        type: textField
        label {
            label: Штрихкод / артикул
            alignment: right
        }
        layout {
            sequence: 10
            region: @scan
            slot: regionBody
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            valuePlaceholder: Відскануйте або введіть і натисніть «Додати»
        }
        advanced {
            customAttributes: autocomplete="off"
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    button scan (
        buttonName: SCAN
        label: Додати
        layout {
            sequence: 20
            region: @scan
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
    )

    button pick (
        buttonName: PICK
        label: Підбір
        layout {
            sequence: 30
            region: @scan
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 950
                clearCache: 950
                items: {
                    P950_KIND: SUPPLIER_ORDER
                    P950_ID: &P271_ID.
                    P950_WH: &P271_WAREHOUSE_ID.
                    P950_SUP: &P271_SUPPLIER_ID.
                }
            }
        }
    )

    dynamicAction after-pick (
        name: Після підбору
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pick
        }
        execution {
            sequence: 10
        }

        action reload (
            name: Перезавантажити
            action: submitPage
            settings {
                requestButtonName: PICKED
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    region lines (
        name: Товари
        title: Товари
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, document_id, line_number, product_id, quantity, price, amount
                  from doc_supplier_order_goods
                 where document_id = :P271_ID
                 order by line_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: tx-tabpart
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P271_STATUS is not null and :P271_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                actionsMenu
            ]
            addButtonLabel: Додати рядок
        }
        advanced {
            savedReportMappingIdentifier: 910000000223
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn LINE_NUMBER (
                column: @LINE_NUMBER
                layout {
                    sequence: 10
                    show: true
                    width: 50
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 380
                }
            )

            displayColumn QUANTITY (
                column: @QUANTITY
                layout {
                    sequence: 30
                    show: true
                    width: 130
                }
            )

            displayColumn PRICE (
                column: @PRICE
                layout {
                    sequence: 40
                    show: true
                    width: 130
                }
            )

            displayColumn AMOUNT (
                column: @AMOUNT
                layout {
                    sequence: 50
                    show: true
                    width: 140
                }
            )
        )

        column ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: ID
                dataType: varchar2
                primaryKey: true
            }
            layout {
                sequence: 10
            }
        )

        column DOCUMENT_ID (
            type: hidden
            source {
                type: databaseColumn
                databaseColumn: DOCUMENT_ID
                dataType: varchar2
            }
            layout {
                sequence: 20
            }
        )

        column LINE_NUMBER (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: LINE_NUMBER
                dataType: number
            }
            heading {
                heading: N
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column PRODUCT_ID (
            type: popupLov
            source {
                type: databaseColumn
                databaseColumn: PRODUCT_ID
                dataType: varchar2
            }
            heading {
                heading: Товар
                alignment: start
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            lov {
                type: sharedComponent
                lov: @products-active
                displayExtraValues: true
                displayNullValue: true
            }
            settings {
                displayAs: inlinePopup
                initialFetch: auto
                manualEntry: false
            }
        )

        column QUANTITY (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: QUANTITY
                dataType: number
            }
            heading {
                heading: Кількість
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            appearance {
                formatMask: FM999G999G999G990D000
            }
        )

        column PRICE (
            type: numberField
            source {
                type: databaseColumn
                databaseColumn: PRICE
                dataType: number
            }
            heading {
                heading: Ціна
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            help {
                helpText: Порожня — остання ціна постачальника.
            }
        )

        column AMOUNT (
            type: displayOnly
            source {
                type: databaseColumn
                databaseColumn: AMOUNT
                dataType: number
                queryOnly: true
            }
            heading {
                heading: Сума
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )
    )

    region cargo (
        name: Вага й об'єм
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return trade_cargo.summary_html('DocSupplierOrder', :P271_ID);
                ```
        }
        layout {
            sequence: 38
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P271_ID
        }
    )

    region footer (
        name: Підвал
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P271_TOTAL_AMOUNT (
        type: displayOnly
        label {
            label: Всього
            alignment: right
        }
        layout {
            sequence: 130
            region: @footer
            slot: regionBody
            columnSpan: 3
            column: 10
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        source {
            formRegion: @header
            column: TOTAL_AMOUNT
            dataType: number
        }
    )

    pageItem P271_DOC_COMMENT (
        type: textarea
        label {
            label: Коментар
            alignment: right
        }
        layout {
            sequence: 140
            region: @footer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @header
            column: DOC_COMMENT
            dataType: varchar2
        }
        settings {
            resizable: true
            autoHeight: false
            charCounter: true
            trimSpaces: leadingAndTrailing
        }
    )

    process form-title (
        name: Заголовок форми
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P271_FORM_TITLE := trade_ui.doc_title('Замовлення постачальнику', :P271_DOC_NUMBER, :P271_OCCURRED_AT, :P271_STATUS);
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000224
        }
    )

    button create-post-close (
        buttonName: CREATE_POST_CLOSE
        label: Провести і закрити
        layout {
            sequence: 10
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P271_ID
        }
    )

    button post-close (
        buttonName: POST_CLOSE
        label: Провести і закрити
        layout {
            sequence: 11
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P271_ID is not null and :P271_STATUS = 'DRAFT'
        }
    )

    button create (
        buttonName: CREATE
        label: Записати
        layout {
            sequence: 20
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P271_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Записати
        layout {
            sequence: 21
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P271_ID is not null and :P271_STATUS = 'DRAFT'
        }
    )

    button create-post (
        buttonName: CREATE_POST
        label: Провести
        layout {
            sequence: 30
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P271_ID
        }
    )

    button post (
        buttonName: POST
        label: Провести
        layout {
            sequence: 31
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P271_ID is not null and :P271_STATUS = 'DRAFT'
        }
    )

    button unpost (
        buttonName: UNPOST
        label: Скасувати проведення
        layout {
            sequence: 40
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Скасувати проведення документа? Рухи регістрів буде видалено.
            style: warning
        }
        serverSideCondition {
            type: item=value
            item: P271_STATUS
            value: POSTED
        }
    )

    button cmd-fill-by-reorder (
        buttonName: FILL_BY_REORDER
        label: Заповнити за потребою
        layout {
            sequence: 41
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P271_ID is not null and :P271_STATUS = 'DRAFT'
        }
    )

    button cmd-refresh-prices (
        buttonName: REFRESH_PRICES
        label: Оновити ціни постачальника
        layout {
            sequence: 42
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P271_ID is not null and :P271_STATUS = 'DRAFT'
        }
    )

    button cmd-create-receipt (
        buttonName: CREATE_RECEIPT
        label: Створити надходження
        layout {
            sequence: 43
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P271_STATUS = 'POSTED' and nvl(:P271_CLOSED, 'N') = 'N'
        }
    )

    button cmd-close-order (
        buttonName: CLOSE_ORDER
        label: Закрити замовлення
        layout {
            sequence: 44
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Закрити замовлення? Неотриманий залишок буде знято.
            style: warning
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P271_STATUS = 'POSTED' and nvl(:P271_CLOSED, 'N') = 'N'
        }
    )

    button cmd-reopen-order (
        buttonName: REOPEN_ORDER
        label: Відкрити замовлення
        layout {
            sequence: 45
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P271_STATUS = 'POSTED' and :P271_CLOSED = 'Y'
        }
    )

    button cmd-create-supplier-payment (
        buttonName: CREATE_SUPPLIER_PAYMENT
        label: Створити оплату постачальнику
        layout {
            sequence: 46
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: item=value
            item: P271_STATUS
            value: POSTED
        }
        security {
            authorizationScheme: @role-purchase-or-cashier
        }
    )

    button cmd-print (
        buttonName: PRINT
        label: Друк
        layout {
