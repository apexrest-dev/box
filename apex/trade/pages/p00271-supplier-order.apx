    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_supplier_order_goods (document_id, line_number, product_id, quantity, price)
                    values (:P271_ID, null,
                            :PRODUCT_ID,
                            to_number(:QUANTITY, 'FM999G999G999G990D000'),
                            to_number(:PRICE, 'FM999G999G999G990D00'))
                    returning id into :ID;
                  when 'U' then
                    update doc_supplier_order_goods
                       set product_id = :PRODUCT_ID,
                           quantity = to_number(:QUANTITY, 'FM999G999G999G990D000'),
                           price = to_number(:PRICE, 'FM999G999G999G990D00')
                     where id = :ID and document_id = :P271_ID;
                  when 'D' then
                    delete from doc_supplier_order_goods where id = :ID and document_id = :P271_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        advanced {
            executionMappingIdentifier: 910000000227
        }
    )

