page 61 (
    name: Оплата постачальнику
    alias: SUPPLIER-PAYMENT
    title: Оплата постачальнику
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-purchase-or-cashier
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>&P61_FORM_TITLE.</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Команди
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region header (
        name: Оплата постачальнику
        title: Оплата постачальнику
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: DOC_SUPPLIER_PAYMENT
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P61_STATUS is not null and :P61_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    pageItem P61_ID (
        type: hidden
        layout {
            sequence: 10
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P61_DOC_NUMBER (
        type: textField
        label {
            label: Номер
            alignment: right
        }
        layout {
            sequence: 20
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @header
            column: DOC_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Порожній номер буде призначено автоматично.
        }
    )

    pageItem P61_OCCURRED_AT (
        type: datePicker
        label {
            label: Дата
            alignment: right
        }
        layout {
            sequence: 30
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: OCCURRED_AT
            dataType: date
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY HH24:MI:SS')
        }
        settings {
            displayAs: popup
            showTime: true
        }
    )

    pageItem P61_ORGANIZATION_ID (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 40
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: ORGANIZATION_ID
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trade_org.default_org
        }
        lov {
            type: sharedComponent
            lov: @organizations-active
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Організація-платник. Документ на підставі отримує організацію підстави.
        }
    )

    pageItem P61_SUPPLIER_ID (
        type: popupLov
        label {
            label: Постачальник
            alignment: right
        }
        layout {
            sequence: 50
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: SUPPLIER_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @counterparties-active
            displayExtraValues: true
            displayNullValue: true
        }
        settings {
            displayAs: inlinePopup
            initialFetch: auto
            manualEntry: false
        }
    )

    pageItem P61_PAYMENT_FORM (
        type: selectList
        label {
            label: Форма оплати
            alignment: right
        }
        layout {
            sequence: 60
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: PAYMENT_FORM
            dataType: varchar2
        }
        default {
            type: static
            staticValue: BANK
        }
        lov {
            type: sharedComponent
            lov: @payment-forms
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Безготівкова — списання з банківського рахунку (друк: платіжна інструкція); готівкова — видача з каси (друк: КО-2). Документ сам рухає кошти: рядок банківської виписки з цією оплатою лише звіряється.
        }
    )

    pageItem P61_BANK_ACCOUNT_ID (
        type: popupLov
        label {
            label: Банківський рахунок
            alignment: right
        }
        layout {
            sequence: 70
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: BANK_ACCOUNT_ID
            dataType: varchar2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select name d, id r
                  from ref_bank_account
                 where state = 'ACTIVE' and currency_code = 'UAH' and organization_id = :P61_ORGANIZATION_ID
                 order by case is_default when 'Y' then 0 else 1 end, name
                ```
            displayExtraValues: true
            displayNullValue: true
        }
        cascadingLov {
            parentItems: [
                P61_ORGANIZATION_ID
            ]
            parentRequired: false
        }
        help {
            helpText: Порожній — основний гривневий рахунок організації.
        }
    )

    pageItem P61_CASH_DESK_ID (
        type: popupLov
        label {
            label: Каса
            alignment: right
        }
        layout {
            sequence: 80
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CASH_DESK_ID
            dataType: varchar2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select name || ' (' || currency_code || ')' d, id r
                  from ref_cash_desk
                 where state = 'ACTIVE' and currency_code = 'UAH' and organization_id = :P61_ORGANIZATION_ID
                 order by code
                ```
            displayExtraValues: true
            displayNullValue: true
        }
        cascadingLov {
            parentItems: [
                P61_ORGANIZATION_ID
            ]
            parentRequired: false
        }
        help {
            helpText: Порожня — перша гривнева каса організації.
        }
    )

    pageItem P61_CURRENCY_CODE (
        type: displayOnly
        label {
            label: Валюта
            alignment: right
        }
        layout {
            sequence: 90
            region: @header
            slot: regionBody
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CURRENCY_CODE
            dataType: varchar2
        }
    )

    pageItem P61_AMOUNT (
        type: numberField
        label {
            label: Сума оплати
            alignment: right
        }
        layout {
            sequence: 100
            region: @header
            slot: regionBody
            columnSpan: 4
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: FM999G999G999G990D00
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: AMOUNT
            dataType: number
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
        }
    )

    pageItem P61_CONTRACT_ID (
        type: popupLov
        label {
            label: Договір
            alignment: right
        }
        layout {
            sequence: 110
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: CONTRACT_ID
            dataType: varchar2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.name || case when c.contract_number is not null then ' № ' || c.contract_number end d, c.id r
                  from ref_contract c
                 where c.state = 'ACTIVE' and c.contract_kind = 'WITH_SUPPLIER'
                   and c.owner_id = :P61_SUPPLIER_ID
                 order by c.name
                ```
            displayExtraValues: true
            displayNullValue: true
        }
        cascadingLov {
            parentItems: [
                P61_SUPPLIER_ID
            ]
            parentRequired: false
        }
        help {
            helpText: Список договорів обраного контрагента. Якщо договір один — підставляється автоматично.
        }
    )

    pageItem P61_SUPPLIER_ORDER_ID (
        type: popupLov
        label {
            label: Замовлення постачальнику
            alignment: right
        }
        layout {
            sequence: 120
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: SUPPLIER_ORDER_ID
            dataType: varchar2
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Замовлення № ' || o.doc_number || ' від ' || to_char(o.occurred_at, 'DD.MM.YYYY') || ' — '
                       || to_char(o.total_amount, 'FM999G999G999G990D00') || ' (сплачено '
                       || to_char(trade_pay_doc.paid_by_order(o.id), 'FM999G999G999G990D00') || ')' d, o.id r
                  from doc_supplier_order o
                 where o.status = 'POSTED' and o.supplier_id = :P61_SUPPLIER_ID
                   and o.organization_id = :P61_ORGANIZATION_ID
                 order by o.occurred_at desc
                ```
            displayExtraValues: true
            displayNullValue: true
        }
        cascadingLov {
            parentItems: [
                P61_SUPPLIER_ID
                P61_ORGANIZATION_ID
            ]
            parentRequired: false
        }
        help {
            helpText: Проведене замовлення цього постачальника; договір підставляється із замовлення.
        }
    )

    pageItem P61_RECIPIENT_IBAN (
        type: textField
        label {
            label: IBAN отримувача
            alignment: right
        }
        layout {
            sequence: 130
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 40
        }
        source {
            formRegion: @header
            column: RECIPIENT_IBAN
            dataType: varchar2
        }
        help {
            helpText: Порожній — IBAN із картки постачальника. Для друку платіжної інструкції.
        }
    )

    pageItem P61_PURPOSE (
        type: textField
        label {
            label: Призначення платежу
            alignment: right
        }
        layout {
            sequence: 140
            region: @header
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @header
            column: PURPOSE
            dataType: varchar2
        }
        help {
            helpText: Порожнє — «Оплата за товар згідно з …» (підстава, замовлення, договір).
        }
    )

    pageItem P61_BASE_DOC_ID (
        type: displayOnly
        label {
            label: Документ-підстава
            alignment: right
        }
        layout {
            sequence: 150
            region: @header
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @header
            column: BASE_DOC_ID
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @recorders
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    pageItem P61_BASE_DOC_TYPE (
        type: hidden
        layout {
            sequence: 160
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: BASE_DOC_TYPE
            dataType: varchar2
        }
    )

    pageItem P61_STATUS (
        type: hidden
        layout {
            sequence: 170
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: STATUS
            dataType: varchar2
        }
        settings {
            valueProtected: true
        }
    )

    pageItem P61_FORM_TITLE (
        type: hidden
        layout {
            sequence: 180
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    pageItem P61_NEW_ID (
        type: hidden
        layout {
            sequence: 190
            region: @header
            slot: regionBody
        }
        sessionState {
            dataType: varchar2
            storage: request
        }
    )

    region footer (
        name: Підвал
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P61_DOC_COMMENT (
        type: textarea
        label {
            label: Коментар
            alignment: right
        }
        layout {
            sequence: 200
            region: @footer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @header
            column: DOC_COMMENT
            dataType: varchar2
        }
        settings {
            resizable: true
            autoHeight: false
            charCounter: true
            trimSpaces: leadingAndTrailing
        }
    )

    process form-title (
        name: Заголовок форми
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P61_FORM_TITLE := trade_ui.doc_title('Оплата постачальнику', :P61_DOC_NUMBER, :P61_OCCURRED_AT, :P61_STATUS);
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000128
        }
    )

    dynamicAction operation-kind (
        name: Вид операції
        when {
            event: change
            selectionType: items
            items: P61_PAYMENT_FORM
        }
        execution {
            sequence: 30
        }

        action toggle (
            name: Поля за видом операції
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var f = $v('P61_PAYMENT_FORM');
                    function sh(i, on) { var it = apex.item(i); if (on) { it.show(); } else { it.hide(); } }
                    sh('P61_BANK_ACCOUNT_ID', f !== 'CASH');
                    sh('P61_RECIPIENT_IBAN', f !== 'CASH');
                    sh('P61_CASH_DESK_ID', f === 'CASH');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )
    )

    button create-post-close (
        buttonName: CREATE_POST_CLOSE
        label: Провести і закрити
        layout {
            sequence: 10
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P61_ID
        }
    )

    button post-close (
        buttonName: POST_CLOSE
        label: Провести і закрити
        layout {
            sequence: 11
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P61_ID is not null and :P61_STATUS = 'DRAFT'
        }
    )

    button create (
        buttonName: CREATE
        label: Записати
        layout {
            sequence: 20
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P61_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Записати
        layout {
            sequence: 21
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P61_ID is not null and :P61_STATUS = 'DRAFT'
        }
    )

    button create-post (
        buttonName: CREATE_POST
        label: Провести
        layout {
            sequence: 30
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P61_ID
        }
    )

    button post (
        buttonName: POST
        label: Провести
        layout {
            sequence: 31
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P61_ID is not null and :P61_STATUS = 'DRAFT'
        }
    )

    button unpost (
        buttonName: UNPOST
        label: Скасувати проведення
        layout {
            sequence: 40
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Скасувати проведення документа? Рухи регістрів буде видалено.
            style: warning
        }
        serverSideCondition {
            type: item=value
            item: P61_STATUS
            value: POSTED
        }
    )

    button cmd-print (
        buttonName: PRINT
        label: Друк
        layout {
            sequence: 41
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P61_ID
        }
    )

    button copy (
        buttonName: COPY
        label: Скопіювати (F9)
        layout {
            sequence: 50
            region: @actions
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P61_ID
        }
    )

    button close (
        buttonName: CLOSE
        label: Закрити
        layout {
            sequence: 60
            region: @actions
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 60
            }
        }
    )

    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @header
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000129
        }
    )

    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000130
        }
    )

    process post (
        name: Провести
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_warn.clear;
                trade_pay_doc.post_supplier_payment(:P61_ID);
                :TRADE_WARN := trade_warn.take;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ проведено. &TRADE_WARN.
        }
        advanced {
            executionMappingIdentifier: 910000000131
        }
    )

    process unpost (
        name: Скасувати проведення
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_pay_doc.unpost_supplier_payment(:P61_ID);
                ```
        }
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @unpost
        }
        successMessage {
            successMessage: Проведення документа скасовано.
        }
        advanced {
            executionMappingIdentifier: 910000000132
        }
    )

    process copy (
        name: Скопіювати
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P61_ID := trade_pay_doc.copy_supplier_payment(:P61_ID);
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @copy
        }
        successMessage {
