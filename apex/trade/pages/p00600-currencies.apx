page 600 (
    name: Валюти
    alias: CURRENCIES
    title: Валюти
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Валюти</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region list (
        name: Валюти
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case state when 'ACTIVE' then 'fa-square tx-ico-item' else 'fa-times tx-ico-marked' end icon_class, ' ' state_icon, id, code, numeric_code, name, symbol, national_name, load_rates_name, current_rate, current_rate_date, rates_count, case state when 'ACTIVE' then 'Активний' else 'Помічений на видалення' end state_name from v_currency_list
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 601
                clearCache: 601
                items: {
                    P601_ID: #ID#
                }
            }
            linkIcon: <span class="fa fa-edit" aria-hidden="true" title="Відкрити"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000093
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

        column STATE_ICON (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ​
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="tx-ico fa #ICON_CLASS#" aria-hidden="true"></span>
            }
        )

        column ICON_CLASS (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: icon
            }
            layout {
                sequence: 30
            }
        )

        column CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Код ISO
            }
            layout {
                sequence: 40
            }
        )

        column NUMERIC_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Цифровий код
            }
            layout {
                sequence: 50
            }
        )

        column NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Найменування
            }
            layout {
                sequence: 60
            }
        )

        column SYMBOL (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Символ
            }
            layout {
                sequence: 70
            }
        )

        column NATIONAL_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Національна
            }
            layout {
                sequence: 80
            }
        )

        column LOAD_RATES_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Курс НБУ
            }
            layout {
                sequence: 90
            }
        )

        column CURRENT_RATE (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Курс сьогодні
            }
            layout {
                sequence: 100
            }
            appearance {
                formatMask: FM999G990D0000
            }
        )

        column CURRENT_RATE_DATE (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата курсу
            }
            layout {
                sequence: 110
            }
            appearance {
                formatMask: DD.MM.YYYY
            }
        )

        column RATES_COUNT (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Записів курсу
            }
            layout {
                sequence: 120
            }
        )
    )

    button create (
        buttonName: CREATE
        label: Створити
        layout {
            sequence: 10
            region: @list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 601
                clearCache: 601
            }
        }
        security {
            authorizationScheme: @role-cashier
        }
    )

    dynamicAction refresh-on-close (
        name: Оновити після закриття діалогу
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @list
        }
        execution {
            sequence: 10
        }

        action refresh (
            name: Оновити
            action: refresh
            affectedElements {
                selectionType: region
                region: @list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
