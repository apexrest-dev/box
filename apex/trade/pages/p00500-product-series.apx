page 500 (
    name: Серії номенклатури
    alias: PRODUCT-SERIES
    title: Серії номенклатури
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Серії номенклатури</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region list (
        name: Серії номенклатури
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case state when 'ACTIVE' then 'fa-square tx-ico-item' else 'fa-times tx-ico-marked' end icon_class, ' ' state_icon, id, code, product_name, name, production_date, expiry_date, expiry_state_name, quantity, case state when 'ACTIVE' then 'Активний' else 'Помічений на видалення' end state_name from v_product_series_list
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 501
                clearCache: 501
                items: {
                    P501_ID: #ID#
                }
            }
            linkIcon: <span class="fa fa-edit" aria-hidden="true" title="Відкрити"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000075
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

        column STATE_ICON (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ​
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="tx-ico fa #ICON_CLASS#" aria-hidden="true"></span>
            }
        )

        column ICON_CLASS (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: icon
            }
            layout {
                sequence: 30
            }
        )

        column CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Код
            }
            layout {
                sequence: 40
            }
        )

        column PRODUCT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Товар
            }
            layout {
                sequence: 50
            }
        )

        column NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Номер серії
            }
            layout {
                sequence: 60
            }
        )

        column PRODUCTION_DATE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Дата виробництва
            }
            layout {
                sequence: 70
            }
        )

        column EXPIRY_DATE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Придатний до
            }
            layout {
                sequence: 80
            }
        )

        column EXPIRY_STATE_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Термін (30 днів)
            }
            layout {
                sequence: 90
            }
        )

        column QUANTITY (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Залишок
            }
            layout {
                sequence: 100
            }
        )
    )

    button create (
        buttonName: CREATE
        label: Створити
        layout {
            sequence: 10
            region: @list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 501
                clearCache: 501
            }
        }
        security {
            authorizationScheme: @role-warehouse-or-purchase
        }
    )

    dynamicAction refresh-on-close (
        name: Оновити після закриття діалогу
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @list
        }
        execution {
            sequence: 10
        }

        action refresh (
            name: Оновити
            action: refresh
            affectedElements {
                selectionType: region
                region: @list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
