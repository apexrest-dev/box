page 400 (
    name: Банківські виписки
    alias: BANK-STATEMENTS
    title: Банківські виписки
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-cashier
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>Банківські виписки</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region list (
        name: Банківські виписки
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.id, case when d.status in ('POSTED', 'ISSUED') then 'fa-file-text-o tx-ico-posted' when d.status = 'CANCELLED' then 'fa-times tx-ico-marked' else 'fa-file-o tx-ico-draft' end icon_class, ' ' state_icon, d.organization_name, d.doc_number, d.occurred_at, d.bank_account_name, d.total_in, d.total_out, d.currency_code, d.line_count, d.unmatched_count, case d.status when 'POSTED' then 'Проведено' else 'Чернетка' end status_name, d.doc_comment
                  from v_bank_statement_list d
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 401
                clearCache: 401
                items: {
                    P401_ID: #ID#
                }
            }
            linkIcon: <span class="fa fa-file-text-o" aria-hidden="true" title="Відкрити"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 910000000321
        }


        column ID (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
        )

        column STATE_ICON (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: ​
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="tx-ico fa #ICON_CLASS#" aria-hidden="true"></span>
            }
        )

        column ICON_CLASS (
            type: hidden
            source {
                dataType: varchar2
            }
            heading {
                heading: icon
            }
            layout {
                sequence: 30
            }
        )

        column DOC_NUMBER (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Номер
            }
            layout {
                sequence: 40
            }
        )

        column OCCURRED_AT (
            type: plainText
            source {
                dataType: date
            }
            heading {
                heading: Дата
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD.MM.YYYY HH24:MI:SS
            }
        )

        column ORGANIZATION_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Організація
            }
            layout {
                sequence: 60
            }
        )

        column BANK_ACCOUNT_NAME (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Банківський рахунок
            }
            layout {
                sequence: 70
            }
        )

        column TOTAL_IN (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Надходження
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column TOTAL_OUT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Списання
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
        )

        column CURRENCY_CODE (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Валюта
            }
            layout {
                sequence: 100
            }
        )

        column LINE_COUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Операцій
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
        )

        column UNMATCHED_COUNT (
            type: plainText
            source {
                dataType: number
            }
            heading {
                heading: Без контрагента
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
        )

        column DOC_COMMENT (
            type: plainText
            source {
                dataType: varchar2
            }
            heading {
                heading: Коментар
            }
            layout {
                sequence: 130
            }
        )
    )

    button create (
        buttonName: CREATE
        label: Створити
        layout {
            sequence: 10
            region: @list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 401
                clearCache: 401
            }
        }
    )
)
