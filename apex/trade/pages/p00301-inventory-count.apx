    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @header
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000257
        }
    )

    process dml (
        name: Записати шапку
        type: formAutoRowProcessing
        formRegion: @header
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('CREATE', 'SAVE', 'POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ записано.
        }
        advanced {
            executionMappingIdentifier: 910000000258
        }
    )

    process dml-lines (
        name: Записати рядки
        type: interactiveGridAutoRowProcessing
        editableRegion: @lines
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    insert into doc_inventory_count_goods (document_id, line_number, product_id, actual_quantity)
                    values (:P301_ID, null,
                            :PRODUCT_ID,
                            to_number(:ACTUAL_QUANTITY, 'FM999G999G999G990D000'))
                    returning id into :ID;
                  when 'U' then
                    update doc_inventory_count_goods
                       set product_id = :PRODUCT_ID,
                           actual_quantity = to_number(:ACTUAL_QUANTITY, 'FM999G999G999G990D000')
                     where id = :ID and document_id = :P301_ID;
                  when 'D' then
                    delete from doc_inventory_count_goods where id = :ID and document_id = :P301_ID;
                end case;
                ```
        }
        lockRow {
            lockRow: true
            preventLostUpdates: true
        }
        execution {
