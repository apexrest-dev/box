page 301 (
    name: Інвентаризація товарів
    alias: INVENTORY-COUNT
    title: Інвентаризація товарів
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @role-warehouse
    }

    region form-title (
        name: Заголовок форми
        type: staticContent
        source {
            htmlCode: <div class="tx-form-title"><span class="tx-nav-btn tx-nav-back" title="Назад" role="button">&#8592;</span><span class="tx-nav-btn tx-nav-forward" title="Вперед" role="button">&#8594;</span><span class="tx-star fa fa-star-o" title="Додати в обране" role="button"></span><h1>&P301_FORM_TITLE.</h1></div>
        }
        layout {
            sequence: 1
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region actions (
        name: Команди
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region header (
        name: Інвентаризація товарів
        title: Інвентаризація товарів
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: DOC_INVENTORY_COUNT
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P301_STATUS is not null and :P301_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    pageItem P301_ID (
        type: hidden
        layout {
            sequence: 10
            region: @header
            slot: regionBody
        }
        source {
            formRegion: @header
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P301_DOC_NUMBER (
        type: textField
        label {
            label: Номер
            alignment: right
        }
        layout {
            sequence: 20
            region: @header
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @header
            column: DOC_NUMBER
            dataType: varchar2
        }
        help {
            helpText: Порожній номер буде призначено автоматично.
        }
    )

    pageItem P301_OCCURRED_AT (
        type: datePicker
        label {
            label: Дата
            alignment: right
        }
        layout {
            sequence: 30
            region: @header
            slot: regionBody
            columnSpan: 3
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            formatMask: DD.MM.YYYY HH24:MI:SS
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: OCCURRED_AT
            dataType: date
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: to_char(sysdate, 'DD.MM.YYYY HH24:MI:SS')
        }
        settings {
            displayAs: popup
            showTime: true
        }
    )

    pageItem P301_ORGANIZATION_ID (
        type: selectList
        label {
            label: Організація
            alignment: right
        }
        layout {
            sequence: 40
            region: @header
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @header
            column: ORGANIZATION_ID
            dataType: varchar2
        }
        default {
            type: expression
            language: plsql
            plsqlExpression: trade_org.default_org
        }
        lov {
            type: sharedComponent
            lov: @organizations-active
            displayExtraValues: true
            displayNullValue: false
        }
        help {
            helpText: Від імені якої організації оформлено документ. Документ на підставі отримує організацію підстави.
        }
    )

    pageItem P301_WAREHOUSE_ID (
