        action reload (
            name: Перезавантажити
            action: submitPage
            settings {
                requestButtonName: PICKED
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    region lines (
        name: Товари
        title: Товари
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, document_id, line_number, product_id, book_quantity, actual_quantity, deviation, price, deviation_amount
                  from doc_inventory_count_goods
                 where document_id = :P301_ID
                 order by line_number
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: tx-tabpart
        }
        readOnly {
            type: expression
            language: plsql
            plsqlExpression: :P301_STATUS is not null and :P301_STATUS <> 'DRAFT'
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
        }
        toolbar {
            show: true
            controls: [
                actionsMenu
            ]
            addButtonLabel: Додати рядок
        }
        advanced {
            savedReportMappingIdentifier: 910000000255
        }

        savedReport primary (
            name: Основний
            visibility: primary
            view {
                default: grid
            }

            displayColumn LINE_NUMBER (
                column: @LINE_NUMBER
                layout {
                    sequence: 10
                    show: true
                    width: 50
                }
            )

            displayColumn PRODUCT_ID (
                column: @PRODUCT_ID
                layout {
                    sequence: 20
                    show: true
                    width: 380
                }
            )

            displayColumn BOOK_QUANTITY (
                column: @BOOK_QUANTITY
                layout {
                    sequence: 30
                    show: true
                    width: 130
                }
            )

            displayColumn ACTUAL_QUANTITY (
                column: @ACTUAL_QUANTITY
                layout {
                    sequence: 40
                    show: true
                    width: 130
                }
            )

            displayColumn DEVIATION (
                column: @DEVIATION
                layout {
                    sequence: 50
                    show: true
                    width: 130
                }
            )

            displayColumn PRICE (
                column: @PRICE
                layout {
                    sequence: 60
                    show: true
                    width: 130
                }
            )

            displayColumn DEVIATION_AMOUNT (
                column: @DEVIATION_AMOUNT
                layout {
                    sequence: 70
                    show: true
                    width: 140
                }
            )
        )

