    process post (
        name: Провести
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_warn.clear;
                trade_cust_pay.post_customer_payment(:P121_ID);
                :TRADE_WARN := trade_warn.take;
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('POST', 'POST_CLOSE', 'CREATE_POST', 'CREATE_POST_CLOSE')
        }
        successMessage {
            successMessage: Документ проведено. &TRADE_WARN.
        }
        advanced {
            executionMappingIdentifier: 910000000171
        }
    )

    process unpost (
        name: Скасувати проведення
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_cust_pay.unpost_customer_payment(:P121_ID);
                ```
        }
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
