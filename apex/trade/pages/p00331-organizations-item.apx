page 331 (
    name: Організація
    alias: ORGANIZATIONS-ITEM
    title: Організація
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 720
        chained: false
    }

    region form (
        name: Організація
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: REF_ORGANIZATION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
            lostUpdateType: rowValues
        }
    )

    region buttons (
        name: Кнопки
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P331_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: ID
            dataType: varchar2
            primaryKey: true
        }
    )

    pageItem P331_CODE (
        type: textField
        label {
            label: Код
            alignment: right
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 9
        }
        source {
            formRegion: @form
            column: CODE
            dataType: varchar2
        }
        help {
            helpText: Порожній код буде призначено автоматично.
        }
    )

    pageItem P331_NAME (
        type: textField
        label {
            label: Найменування
            alignment: right
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
            columnSpan: 9
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
            valueRequired: true
        }
        source {
            formRegion: @form
            column: NAME
            dataType: varchar2
        }
    )

    pageItem P331_FULL_NAME (
        type: textField
        label {
            label: Повне найменування
            alignment: right
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @form
            column: FULL_NAME
            dataType: varchar2
        }
        help {
            helpText: Для друкованих форм; порожнє — використовується найменування.
        }
    )

    pageItem P331_ORG_KIND (
        type: selectList
        label {
            label: Вид
            alignment: right
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: ORG_KIND
            dataType: varchar2
        }
        default {
            type: static
            staticValue: LEGAL
        }
        lov {
            type: sharedComponent
            lov: @org-kinds
            displayExtraValues: true
            displayNullValue: false
        }
    )

    pageItem P331_EDRPOU (
        type: textField
        label {
            label: ЄДРПОУ / РНОКПП
            alignment: right
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @form
            column: EDRPOU
            dataType: varchar2
        }
        help {
            helpText: Юридична особа — код ЄДРПОУ (8 цифр), ФОП — РНОКПП (10 цифр).
        }
    )

    pageItem P331_VAT_PAYER (
        type: switch
        label {
            label: Платник ПДВ
            alignment: right
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: VAT_PAYER
            dataType: varchar2
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Так
            offValue: N
            offLabel: Ні
        }
    )

    pageItem P331_VAT_NUMBER (
        type: textField
        label {
            label: ІПН платника ПДВ
            alignment: right
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 12
        }
        source {
            formRegion: @form
            column: VAT_NUMBER
            dataType: varchar2
        }
        help {
            helpText: 12 цифр; обов'язковий для платника ПДВ.
        }
    )

    pageItem P331_IBAN (
        type: textField
        label {
            label: IBAN
            alignment: right
        }
        layout {
            sequence: 90
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 40
        }
        source {
            formRegion: @form
            column: IBAN
            dataType: varchar2
        }
        help {
            helpText: UA + 27 цифр; пробіли прибираються.
        }
    )

    pageItem P331_BANK_NAME (
        type: textField
        label {
            label: Банк
            alignment: right
        }
        layout {
            sequence: 100
            region: @form
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form
            column: BANK_NAME
            dataType: varchar2
        }
    )

    pageItem P331_ADDRESS (
        type: textField
        label {
            label: Адреса
            alignment: right
        }
        layout {
            sequence: 110
            region: @form
            slot: regionBody
            columnSpan: 8
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @form
            column: ADDRESS
            dataType: varchar2
        }
    )

    pageItem P331_PHONE (
        type: textField
        label {
            label: Телефон
            alignment: right
        }
        layout {
            sequence: 120
            region: @form
            slot: regionBody
            columnSpan: 4
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @form
            column: PHONE
            dataType: varchar2
        }
    )

    pageItem P331_DIRECTOR_NAME (
        type: textField
        label {
            label: Керівник
            alignment: right
        }
        layout {
            sequence: 130
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form
            column: DIRECTOR_NAME
            dataType: varchar2
        }
    )

    pageItem P331_ACCOUNTANT_NAME (
        type: textField
        label {
            label: Головний бухгалтер
            alignment: right
        }
        layout {
            sequence: 140
            region: @form
            slot: regionBody
            columnSpan: 6
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form
            column: ACCOUNTANT_NAME
            dataType: varchar2
        }
    )

    pageItem P331_IS_DEFAULT (
        type: switch
        label {
            label: За замовчуванням
            alignment: right
        }
        layout {
            sequence: 150
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: IS_DEFAULT
            dataType: varchar2
        }
        settings {
            useDefaults: false
            onValue: Y
            onLabel: Так
            offValue: N
            offLabel: Ні
        }
        help {
            helpText: Підставляється в нові документи. Лише одна організація може бути за замовчуванням.
        }
    )

    pageItem P331_GLN (
        type: textField
        label {
            label: GLN (EDI)
            alignment: right
        }
        layout {
            sequence: 160
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 13
        }
        source {
            formRegion: @form
            column: GLN
            dataType: varchar2
        }
        help {
            helpText: Глобальний номер розташування GS1 (13 цифр, остання — контрольна). За ним EDI-повідомлення мереж зіставляються з довідниками. Для організації — GLN постачальника в повідомленнях мереж.
        }
    )

    pageItem P331_STATE (
        type: displayOnly
        label {
            label: Стан
            alignment: right
        }
        layout {
            sequence: 170
            region: @form
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @form
            column: STATE
            dataType: varchar2
        }
        lov {
            type: sharedComponent
            lov: @catalog-states
            displayExtraValues: true
        }
        settings {
            basedOn: lov
            sendOnPageSubmit: true
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Скасувати
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button mark (
        buttonName: MARK
        label: Помітити на видалення
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: Помітити елемент на видалення?
            style: warning
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_ID is not null and :P331_STATE = 'ACTIVE'
        }
        security {
            authorizationScheme: @role-admin
        }
    )

    button restore (
        buttonName: RESTORE
        label: Відновити
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: false
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P331_STATE = 'MARKED_FOR_DELETION'
        }
        security {
            authorizationScheme: @role-admin
        }
    )

    button save (
        buttonName: SAVE
        label: Записати і закрити
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P331_ID
        }
        security {
            authorizationScheme: @role-admin
        }
    )

    button create (
        buttonName: CREATE
        label: Записати і закрити
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P331_ID
        }
        security {
            authorizationScheme: @role-admin
        }
    )

    dynamicAction cancel-dialog (
        name: Скасувати діалог
        when {
            event: click
            selectionType: button
            button: @cancel
        }
        execution {
            sequence: 10
        }

        action cancel-dialog (
            name: Закрити
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process init (
        name: Ініціалізація форми
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 910000000044
        }
    )

    process dml (
        name: Записати
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('SAVE', 'CREATE')
        }
        successMessage {
            successMessage: Елемент записано.
        }
        advanced {
            executionMappingIdentifier: 910000000045
        }
    )

    process mark (
        name: Помітити на видалення
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_core.mark_for_deletion('REF_ORGANIZATION', :P331_ID);
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @mark
        }
        advanced {
            executionMappingIdentifier: 910000000046
        }
    )

    process restore (
        name: Відновити
        type: executeCode
        source {
            language: plsql
            plsqlCode:
                ```plsql
                trade_core.restore('REF_ORGANIZATION', :P331_ID);
                ```
        }
        execution {
            sequence: 30
            point: afterSubmit
        }
        serverSideCondition {
            whenButtonPressed: @restore
        }
        advanced {
            executionMappingIdentifier: 910000000047
        }
    )

    process close (
        name: Закрити діалог
        type: closeDialog
        execution {
            sequence: 40
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST in ('SAVE', 'CREATE', 'MARK', 'RESTORE')
        }
        advanced {
            executionMappingIdentifier: 910000000048
        }
    )
)
